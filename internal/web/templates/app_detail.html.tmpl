{{define "page"}}
{{template "head" .}}
{{template "sidebar-layout-start" .PageData}}

<div class="mb-2">
  <a href="/apps" class="sub" style="text-decoration:none;">&larr; Apps</a>
</div>

<div style="display:flex;align-items:center;gap:0.75rem;" class="mb-3">
  <span class="status-dot {{.Status}}"></span>
  <h2 style="margin:0">{{.Name}}</h2>
  {{if .Category}}<span class="badge">{{.Category}}</span>{{end}}
  <span class="sub" style="font-size:0.85rem">v{{.Version}}</span>
  {{if .UpdateAvailable}}
  <span class="badge" data-variant="{{if .UpdateBreaking}}warning{{else}}success{{end}}">
    {{if .UpdateBreaking}}Update (manuell): v{{.UpdateTo}}{{else}}Update verfuegbar: v{{.UpdateTo}}{{end}}
  </span>
  {{end}}
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;">
  <!-- Left: Info -->
  <div>
    <article class="card mb-2">
      <h4 class="mb-1">Zugriff</h4>
      <table>
        <tbody>
          <tr>
            <td class="sub">Lokal</td>
            <td>
              <a href="http://{{.ServerDomain}}:{{.Port}}" target="_blank" rel="noopener">{{.ServerDomain}}:{{.Port}}</a>
              {{template "copy-btn" (printf "http://%s:%d" .ServerDomain .Port)}}
            </td>
          </tr>
          {{if .TunnelEnabled}}
          <tr>
            <td class="sub">Oeffentlich</td>
            <td>
              <a href="https://{{.TunnelSubdomain}}" target="_blank" rel="noopener">{{.TunnelSubdomain}}</a>
              {{template "copy-btn" (printf "https://%s" .TunnelSubdomain)}}
            </td>
          </tr>
          {{end}}
          <tr>
            <td class="sub">Container</td>
            <td><code>{{.ContainerName}}</code> {{template "copy-btn" .ContainerName}}</td>
          </tr>
          <tr><td class="sub">Installiert</td><td>{{.InstalledAt}}</td></tr>
        </tbody>
      </table>
    </article>

    {{if .HasOIDC}}
    <article class="card mb-2">
      <h4 class="mb-1">OIDC</h4>
      <table>
        <tbody>
          <tr>
            <td class="sub">Client-ID</td>
            <td><code>{{.OIDCClientID}}</code> {{template "copy-btn" .OIDCClientID}}</td>
          </tr>
          <tr>
            <td class="sub">Redirect-URI</td>
            <td style="font-size:0.8rem;word-break:break-all;">
              <code>{{.OIDCRedirectURI}}</code>
              {{template "copy-btn" .OIDCRedirectURI}}
            </td>
          </tr>
        </tbody>
      </table>
      {{if not .TunnelEnabled}}
      <div role="alert" data-variant="warning" class="mt-2" style="font-size:0.85rem;">
        Diese App nutzt OIDC, ist aber nicht getunnelt. Login funktioniert nur mit aktivem Tunnel.
      </div>
      {{end}}
    </article>
    {{end}}

    {{if or .AdminLogin .AdminPassword .AdminNotes}}
    <article class="card mb-2">
      <h4 class="mb-1">Admin-Login</h4>
      <table>
        <tbody>
          {{if .AdminLogin}}
          <tr>
            <td class="sub">Benutzer</td>
            <td><code>{{.AdminLogin}}</code> {{template "copy-btn" .AdminLogin}}</td>
          </tr>
          {{end}}
          {{if .AdminPassword}}
          <tr><td class="sub">Passwort</td><td>{{.AdminPassword}}</td></tr>
          {{end}}
        </tbody>
      </table>
      {{if .AdminNotes}}
      <p class="sub mt-1" style="font-size:0.85rem;white-space:pre-wrap;">{{.AdminNotes}}</p>
      {{end}}
    </article>
    {{end}}

    {{if or .Homepage .Docs}}
    <article class="card">
      <h4 class="mb-1">Links</h4>
      <div style="display:flex;gap:1rem;">
        {{if .Homepage}}<a href="{{.Homepage}}" target="_blank">Homepage</a>{{end}}
        {{if .Docs}}<a href="{{.Docs}}" target="_blank">Docs</a>{{end}}
      </div>
    </article>
    {{end}}
  </div>

  <!-- Right: Actions -->
  <div>
    {{if .HasOIDC}}
    <article class="card mb-2">
      <h4 class="mb-1">Tunnel</h4>
      {{if .TunnelEnabled}}
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span class="status-dot running"></span>
        <span>Aktiv</span>
        <span class="tunnel-url" style="margin-left:auto;">{{.TunnelSubdomain}}</span>
      </div>
      <form method="post" action="/apps/{{.ID}}/tunnel/disable" class="mt-2">
        {{csrfField $.CSRFToken}}
        <button class="ghost small" data-variant="danger">Tunnel deaktivieren</button>
      </form>
      {{else}}
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <span class="status-dot stopped"></span>
        <span>Inaktiv</span>
      </div>
      <form method="post" action="/apps/{{.ID}}/tunnel/enable" class="mt-2">
        {{csrfField $.CSRFToken}}
        <button class="ghost small">Tunnel aktivieren</button>
      </form>
      {{end}}
    </article>
    {{end}}

    <article class="card mb-2">
      <h4 class="mb-1">Aktionen</h4>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
        {{if eq .Status "running"}}
        <form method="post" action="/apps/{{.ID}}/stop" style="display:inline">
        {{csrfField $.CSRFToken}}
          <button class="ghost small" data-variant="danger">Stoppen</button>
        </form>
        {{else}}
        <form method="post" action="/apps/{{.ID}}/start" style="display:inline">
        {{csrfField $.CSRFToken}}
          <button class="ghost small">Starten</button>
        </form>
        {{end}}
        <form method="post" action="/apps/{{.ID}}/update" style="display:inline"
              data-loading-msg="Aktualisiere… (compose pull kann ein paar Minuten dauern)"
              onsubmit="return confirm('Katalog-Definition neu laden und Image aktualisieren? Der Container wird kurz neu gestartet.')">
        {{csrfField $.CSRFToken}}
          <button class="ghost small">Aktualisieren</button>
        </form>
      </div>
      <p class="sub mt-1" style="font-size:0.8rem">
        Holt die aktuelle Katalog-Definition + neueste Image-Version und
        startet den Container neu. Daten und Secrets bleiben erhalten.
      </p>
      {{if .UpdateBreaking}}
      <div role="alert" data-variant="warning" class="mt-2" style="font-size:0.85rem">
        Dieses Update ist als <strong>breaking</strong> markiert (z.B. DB-Migration).
        Auto-Update ueberspringt es; bitte vorher Backup pruefen.
      </div>
      {{end}}
    </article>

    <article class="card mb-2">
      <h4 class="mb-1">Auto-Update</h4>
      <form method="post" action="/apps/{{.ID}}/autoupdate">
        {{csrfField $.CSRFToken}}
        <label data-field class="mb-1" style="font-size:0.85rem;">
          <input type="checkbox" name="disabled" {{if .AutoUpdateDisabled}}checked{{end}}>
          Diese App vom naechtlichen Auto-Update ausnehmen
        </label>
        <button class="ghost small">Speichern</button>
      </form>
      <p class="sub mt-1" style="font-size:0.8rem">
        Globaler Auto-Update-Schalter ist in den Einstellungen.
        Breaking-Updates werden immer uebersprungen.
      </p>
    </article>

    <article class="card">
      <h4 class="mb-1">Entfernen</h4>
      {{if .IsMandatory}}
      <div role="alert" data-variant="warning" class="mb-1" style="font-size:0.85rem">
        <strong>Pflicht-Container.</strong> {{.Name}} wird vom Rest des Stacks
        benoetigt — andere Apps funktionieren ohne ihn nicht mehr.
      </div>
      {{end}}
      <p class="sub mb-1" style="font-size:0.85rem">
        Container, Konfiguration und das Docker-Image werden entfernt.
        Daten unter <code>/opt/learningstack/{{.ID}}/</code> bleiben per
        Default erhalten und werden bei einer Neuinstallation wiederverwendet.
      </p>
      <form method="post" action="/apps/{{.ID}}/remove"
            data-loading-msg="Entferne… (Container stoppen, Image loeschen)"
            onsubmit="return confirm(this.wipe_data.checked
              ? 'App {{.Name}} entfernen UND alle Daten loeschen? Das ist nicht umkehrbar.'
              : 'App {{.Name}}{{if .IsMandatory}} (Pflicht-Container!){{end}} wirklich entfernen?')">
        {{csrfField $.CSRFToken}}
        <label data-field class="mb-1" style="font-size:0.85rem;">
          <input type="checkbox" name="wipe_data">
          Auch Daten loeschen (Postgres-DB + <code>/opt/learningstack/{{.ID}}/</code>)
        </label>
        <button data-variant="danger" class="small">App entfernen</button>
      </form>
    </article>
  </div>
</div>

{{template "sidebar-layout-end" .PageData}}
{{template "foot" .}}
{{end}}

{{define "title"}}{{.Job.Title}}{{end}}
{{define "page"}}
{{template "head" .}}
{{template "shell-start" .PageData}}

<div class="sc-job">
  <div class="ls-pagehead">
    <span class="ls-notice-icon sc-job-icon" data-tone="info" id="job-tile">{{template "dock-icon" "refresh"}}</span>
    <div>
      <h1 id="job-title">{{.Job.Title}}</h1>
      <p><span class="ls-pill" data-tone="info" id="job-status">läuft</span> <span class="ls-num" id="job-elapsed">0:00</span></p>
    </div>
  </div>

  <div class="ls-list" id="job-steps" aria-live="polite"></div>

  <details class="ls-list sc-job-log" id="job-log-wrap" hidden>
    <summary class="ls-row"><span class="ls-row-label">Protokoll</span></summary>
    <pre id="job-log"></pre>
  </details>

  <div id="job-result" class="sc-job-result" aria-live="polite"></div>
</div>

{{template "shell-end" .PageData}}
<script>
(function () {
  // jsString escapes the value but does NOT add quotes, so wrap each in '…' —
  // a bare hex job id (e.g. c635…) would otherwise be read as an undefined
  // identifier and crash the whole script (no polling, no restart redirect).
  var jobID = '{{.Job.ID | jsString}}';
  var jobKind = '{{.Job.Kind | jsString}}';
  var backURL = '{{.Job.BackURL | jsString}}';
  // Boot id of the process that rendered this page. After a self-update a new
  // process answers /healthz with a different id — that's how we detect the
  // restart (see waitForRestart) without depending on catching the down moment.
  var bootBaseline = '{{.BootID | jsString}}';
  var pollTimer = null;

  var ICON = { done: 'check-circle', failed: 'alert', running: 'refresh', pending: 'chevron-right' };
  var SPRITE = '/static/ls/icons/icons.svg#';

  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function icon(name) {
    return '<svg class="ls-icon" aria-hidden="true"><use href="' + SPRITE + name + '"/></svg>';
  }
  function fmtElapsed(sec) {
    var m = Math.floor(sec / 60), s = sec % 60;
    return m + ':' + (s < 10 ? '0' : '') + s;
  }
  function setStatus(tone, word) {
    var p = document.getElementById('job-status');
    p.dataset.tone = tone; p.textContent = word;
  }

  function renderSteps(steps) {
    var list = document.getElementById('job-steps');
    list.hidden = !(steps && steps.length);
    list.innerHTML = (steps || []).map(function (st) {
      return '<div class="ls-row sc-step" data-state="' + esc(st.status) + '">' +
             icon(ICON[st.status] || 'chevron-right') +
             '<span class="ls-row-label">' + esc(st.name) + '</span></div>';
    }).join('');
  }

  function renderLog(lines) {
    var wrap = document.getElementById('job-log-wrap');
    if (!lines || !lines.length) { wrap.hidden = true; return; }
    wrap.hidden = false;
    var pre = document.getElementById('job-log');
    var atBottom = pre.scrollTop + pre.clientHeight >= pre.scrollHeight - 4;
    pre.textContent = lines.join('\n');
    if (atBottom) pre.scrollTop = pre.scrollHeight;
  }

  function renderResult(job) {
    var html = '';
    if (job.success) {
      html += '<p class="sc-flash" data-tone="ok" role="status">' + icon('check-circle') + '<span>Fertig.</span></p>';
    } else {
      html += '<p class="sc-flash" data-tone="bad" role="alert">' + icon('alert') + '<span>Hat nicht geklappt: ' + esc(job.error || 'unbekannter Fehler') + '</span></p>';
    }
    if (job.messages && job.messages.length) {
      html += '<span class="ls-list-label">Hinweise</span><div class="ls-list">';
      job.messages.forEach(function (m) { html += '<div class="ls-row"><span class="ls-row-label sc-pre">' + esc(m) + '</span></div>'; });
      html += '</div>';
    }
    if (job.secrets_to_show) {
      var keys = Object.keys(job.secrets_to_show);
      if (keys.length) {
        html += '<span class="ls-list-label">Zugangsdaten</span><div class="ls-list">';
        keys.forEach(function (k) {
          var v = job.secrets_to_show[k];
          html += '<div class="ls-row"><span class="ls-row-label">' + esc(k) + '<small class="sc-break"><code>' + esc(v) + '</code></small></span>' +
                  '<button type="button" class="sc-copy" data-copy="' + esc(v) + '" aria-label="Kopieren">' + icon('copy') + '</button></div>';
        });
        html += '</div><p class="ls-list-hint">Werden nur jetzt angezeigt. Bitte kopieren und sicher aufbewahren.</p>';
      }
    }
    html += '<div class="ls-actions sc-job-actions"><a class="ls-btn" href="' + esc(backURL || '/') + '">Weiter</a></div>';
    document.getElementById('job-result').innerHTML = html;
  }

  // After a self-update the server exits and systemd restarts it with the new
  // binary. Poll /healthz until it answers, then go back to settings.
  function restartDone() {
    if (jobKind === 'restore') {
      return (backURL || '/backups') + '?msg=' + encodeURIComponent('Wiederherstellung abgeschlossen.');
    }
    return (backURL || '/settings') + '?update=stackctl+wurde+aktualisiert';
  }

  // waitForRestart polls /healthz until a NEW stackctl process is up, then
  // reloads into it. A restart is detected primarily by a changed boot id
  // (X-Stackctl-Boot) — robust even when systemd brings the new process back
  // faster than the 1s poll interval, in which case the old down→up approach
  // never observes a failing ping and the page would hang forever. The wasDown
  // transition is kept as a fallback for the case where no boot id is available
  // (page rendered by an older binary). alreadyUp is passed when we detected
  // the restart via a 404 — a fresh process is already serving — so we reload
  // at once.
  function waitForRestart(alreadyUp) {
    var msg = jobKind === 'restore'
      ? 'Wiederherstellung abgeschlossen. stackctl startet neu, die Seite wechselt gleich von selbst.'
      : 'Update installiert. stackctl startet neu, die Seite wechselt gleich von selbst.';
    setStatus('info', 'startet neu');
    document.getElementById('job-result').innerHTML =
      '<p class="sc-flash" data-tone="ok" role="status">' + icon('refresh') + '<span>' + msg + '</span></p>';
    if (alreadyUp) { window.location = restartDone(); return; }
    var tries = 0, wasDown = false;
    (function ping() {
      tries++;
      fetch('/healthz', { cache: 'no-store' })
        .then(function (r) {
          var boot = r.headers.get('X-Stackctl-Boot');
          // A different boot id means a new process is serving — reload. Guarded
          // by a non-empty baseline so an old page (empty baseline) can't redirect
          // prematurely off the still-running old process.
          var restarted = bootBaseline && boot && boot !== bootBaseline;
          if (r.ok && (restarted || wasDown)) { window.location = restartDone(); return; }
          if (!r.ok) wasDown = true;
          if (tries < 300) setTimeout(ping, 1000);
        })
        .catch(function () { wasDown = true; if (tries < 300) setTimeout(ping, 1000); });
    })();
  }

  function apply(job) {
    document.getElementById('job-title').textContent = job.title;
    document.getElementById('job-elapsed').textContent = fmtElapsed(job.elapsed_sec || 0);
    renderSteps(job.steps);
    renderLog(job.log);
    if (!job.done) { setStatus('info', 'läuft'); return false; }
    if (job.restarting) { waitForRestart(false); return true; }
    setStatus(job.success ? 'ok' : 'bad', job.success ? 'fertig' : 'fehlgeschlagen');
    var tile = document.getElementById('job-tile');
    tile.dataset.tone = job.success ? 'ok' : 'bad';
    tile.innerHTML = '<svg aria-hidden="true"><use href="' + SPRITE + (job.success ? 'check' : 'alert') + '"/></svg>';
    renderResult(job);
    return true;
  }

  function poll() {
    fetch('/jobs/' + jobID + '/status', { cache: 'no-store' })
      .then(function (r) {
        if (!r.ok) throw new Error('status ' + r.status);
        return r.json();
      })
      .then(function (job) {
        var finished = apply(job);
        if (finished && pollTimer) { clearInterval(pollTimer); pollTimer = null; }
      })
      .catch(function (err) {
        // A failing poll during a self-update or restore means the server is
        // restarting (os.Exit → systemd). A 404 means a fresh process is already
        // serving (it no longer knows this job) → reload at once; any other
        // failure means it is mid-restart → wait for /healthz to recover.
        if (jobKind === 'selfupdate' || jobKind === 'restore') {
          if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
          var gone = String(err && err.message).indexOf('404') !== -1;
          waitForRestart(gone);
        }
      });
  }

  poll();
  pollTimer = setInterval(poll, 1200);
})();
</script>
{{template "foot" .}}
{{end}}

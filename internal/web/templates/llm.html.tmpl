{{define "title"}}KI{{end}}
{{define "page"}}
{{template "head" .}}
{{template "shell-start" .PageData}}

<div class="ls-pagehead">
  <span class="ls-tile" data-size="m" style="--ls-hue: 300">{{template "dock-icon" "spark"}}</span>
  <div>
    <h1>KI-Dienst</h1>
    <p>{{len .Providers}} {{if eq (len .Providers) 1}}Anbieter{{else}}Anbieter{{end}} · {{len .Personas}} {{if eq (len .Personas) 1}}Modell{{else}}Modelle{{end}} · {{len .APIKeys}} {{if eq (len .APIKeys) 1}}Schlüssel{{else}}Schlüssel{{end}}</p>
  </div>
</div>

<div class="ls-split" data-panels data-default="{{if eq .ActiveTab "personas"}}modelle{{else if eq .ActiveTab "keys"}}schluessel{{else}}anbieter{{end}}">
  <nav aria-label="Bereiche des KI-Dienstes">
    <div class="ls-list">
      <a class="ls-row" href="#anbieter"><span class="ls-row-label">Anbieter</span><span class="ls-split-count">{{len .Providers}}</span>{{template "icon" "chevron-right"}}</a>
      <a class="ls-row" href="#modelle"><span class="ls-row-label">Modelle für Apps</span><span class="ls-split-count">{{len .Personas}}</span>{{template "icon" "chevron-right"}}</a>
      <a class="ls-row" href="#schluessel"><span class="ls-row-label">Zugangsschlüssel</span><span class="ls-split-count">{{len .APIKeys}}</span>{{template "icon" "chevron-right"}}</a>
    </div>
  </nav>

  <div>
    {{if .Message}}<p class="sc-flash" data-tone="ok" role="status">{{template "icon" "check-circle"}}<span>{{.Message}}</span></p>{{end}}
    {{if .Error}}<p class="sc-flash" data-tone="bad" role="alert">{{template "icon" "alert"}}<span>{{.Error}}</span></p>{{end}}

    <section class="ls-panel" id="anbieter" aria-labelledby="h-anbieter">
      <h2 id="h-anbieter">Anbieter</h2>
      <p>Woher die KI kommt: ein Dienst, der wie OpenAI spricht, etwa OpenAI selbst oder Ollama im Schulnetz. Die Apps sehen davon nichts, sie reden nur mit dem KI-Dienst der Schule.</p>
      <span class="ls-list-label">Eingerichtet</span>
      <div class="ls-list">
        {{range .Providers}}
        <button type="button" class="ls-row" data-ls-open="prov-{{.ID}}">
          <span class="ls-tile" data-size="s" style="--ls-hue: {{hue .ID}}"><b>{{abbr .ID}}</b></span>
          <span class="ls-row-label">{{.ID}}<small><code>{{.BaseURL}}</code></small></span>
          {{if .APIKey}}<span class="ls-pill" data-tone="ok">Schlüssel da</span>{{else}}<span class="ls-pill" data-tone="off">ohne Schlüssel</span>{{end}}
          {{template "icon" "chevron-right"}}
        </button>
        {{else}}
        <div class="ls-row"><span class="ls-row-label">Noch kein Anbieter<small>Ohne Anbieter antwortet keine KI.</small></span></div>
        {{end}}
      </div>
      <p class="ls-list-hint">Anfragen an Anbieter im Internet enthalten, was Schüler:innen eintippen.</p>
      <div class="ls-actions sc-gap-s"><button type="button" data-variant="ghost" data-ls-open="prov-new">{{template "icon" "plus"}}Anbieter hinzufügen</button></div>
    </section>

    <section class="ls-panel" id="modelle" aria-labelledby="h-modelle">
      <h2 id="h-modelle">Modelle für Apps</h2>
      <p>Was Apps unter einem Namen bekommen: ein Modell eines Anbieters, auf Wunsch mit fester Anweisung. So wechselst du den Anbieter, ohne eine App anzufassen.</p>
      <span class="ls-list-label">Angelegt</span>
      <div class="ls-list">
        {{range .Personas}}
        <button type="button" class="ls-row" data-ls-open="pers-{{.ID}}">
          <span class="ls-row-label">{{.ID}}<small>{{if and .Provider .UpstreamID}}{{.Provider}} · {{.UpstreamID}}{{else}}keinem Anbieter zugeordnet{{end}}{{if .Prompt}} · mit Anweisung{{end}}</small></span>
          {{if and .Provider .UpstreamID}}<span class="ls-pill" data-tone="ok">aktiv</span>{{else}}<span class="ls-pill" data-tone="off">inaktiv</span>{{end}}
          {{template "icon" "chevron-right"}}
        </button>
        {{else}}
        <div class="ls-row"><span class="ls-row-label">Noch kein Modell<small>Apps sehen nur Modelle, die hier stehen.</small></span></div>
        {{end}}
      </div>
      <div class="ls-actions sc-gap-s"><button type="button" data-variant="ghost" data-ls-open="pers-new">{{template "icon" "plus"}}Modell anlegen</button></div>
    </section>

    <section class="ls-panel" id="schluessel" aria-labelledby="h-schluessel">
      <h2 id="h-schluessel">Zugangsschlüssel</h2>
      <p>Damit melden sich Apps beim KI-Dienst an. Eine App aus dem Katalog bekommt ihren Schlüssel beim Installieren selbst.</p>

      {{if .NewKey}}
      <div class="sc-sheet-note" data-tone="ok" role="status">{{template "icon" "key"}}<div class="sc-newkey">
        <strong>Schlüssel „{{.NewKeyID}}“ ist angelegt.</strong>
        <span>Er wird nur jetzt angezeigt. Bitte kopieren und dort eintragen, wo er gebraucht wird.</span>
        <div class="sc-suffix"><code class="sc-break">{{.NewKey}}</code>{{template "copy-btn" .NewKey}}</div>
      </div></div>
      {{end}}

      <span class="ls-list-label">Vergeben</span>
      <div class="ls-list">
        {{range .APIKeys}}
        <div class="ls-row">
          <span class="ls-row-label">{{.ID}}<small><code>{{.Prefix}}…</code> · {{if .AllowedPersonas}}nur {{join .AllowedPersonas ", "}}{{else}}alle Modelle{{end}}</small></span>
          <button type="button" data-size="s" data-variant="danger" data-ls-open="key-del-{{.ID}}">Sperren</button>
        </div>
        {{else}}
        <div class="ls-row"><span class="ls-row-label">Noch kein Schlüssel</span></div>
        {{end}}
      </div>
      <div class="ls-actions sc-gap-s"><button type="button" data-variant="ghost" data-ls-open="key-new">{{template "icon" "plus"}}Schlüssel erstellen</button></div>
    </section>
  </div>
</div>

{{/* ── Blätter: Anbieter ─────────────────────────────────── */}}
<dialog class="ls-sheet" id="prov-new" aria-labelledby="prov-new-t">
  <form method="dialog" class="ls-sheet-bar"><button class="ls-iconbtn" aria-label="Schließen">{{template "icon" "x"}}</button></form>
  <div class="ls-sheet-hero"><h2 id="prov-new-t">Anbieter hinzufügen</h2><p>Ein Dienst, der wie OpenAI spricht.</p></div>
  <form method="post" action="/llm/providers">
    {{csrfField .CSRFToken}}
    <div class="ls-list">
      <div class="ls-field"><label for="pn-id">Kurzname</label><input id="pn-id" name="id" required pattern="[a-z0-9][a-z0-9._-]*" placeholder="openai" autocapitalize="none" spellcheck="false"><span class="ls-field-hint">Kleinbuchstaben, Ziffern, Punkt, Strich.</span></div>
      <div class="ls-field"><label for="pn-url">Adresse</label><input id="pn-url" type="url" name="base_url" required placeholder="https://api.openai.com"><span class="ls-field-hint">Ohne <code>/v1</code> am Ende.</span></div>
      <div class="ls-field"><label for="pn-key">Schlüssel</label><input id="pn-key" type="password" name="api_key" placeholder="sk-…" autocomplete="off"><span class="ls-field-hint">Lässt sich auch später eintragen.</span></div>
    </div>
    <details class="ls-list sc-gap-s">
      <summary class="ls-row"><span class="ls-row-label">Für Fortgeschrittene</span></summary>
      <div class="ls-field"><label for="pn-kind">Art</label><input id="pn-kind" name="kind" value="openai"></div>
    </details>
    <div class="ls-sheet-foot"><button type="button" data-variant="ghost" data-close>Abbrechen</button><button type="submit" data-busy>Hinzufügen</button></div>
  </form>
</dialog>

{{range .Providers}}
<dialog class="ls-sheet" id="prov-{{.ID}}" aria-labelledby="prov-{{.ID}}-t">
  <form method="dialog" class="ls-sheet-bar"><button class="ls-iconbtn" aria-label="Schließen">{{template "icon" "x"}}</button></form>
  <div class="ls-sheet-hero">
    <span class="ls-tile" style="--ls-hue: {{hue .ID}}"><b>{{abbr .ID}}</b></span>
    <h2 id="prov-{{.ID}}-t">{{.ID}}</h2>
    <p><code>{{.BaseURL}}</code></p>
    {{if .APIKey}}<span class="ls-pill" data-tone="ok">Schlüssel da</span>{{else}}<span class="ls-pill" data-tone="off">ohne Schlüssel</span>{{end}}
  </div>
  <span class="ls-list-label">Schlüssel</span>
  <form method="post" action="/llm/providers/{{.ID}}/key">
    {{csrfField $.CSRFToken}}
    <div class="ls-list">
      <div class="ls-field"><label for="pk-{{.ID}}">{{if .APIKey}}Neuer Schlüssel{{else}}Schlüssel{{end}}</label><input id="pk-{{.ID}}" type="password" name="api_key" autocomplete="off" placeholder="sk-…"></div>
    </div>
    <div class="ls-sheet-foot">
      {{if .APIKey}}<button type="submit" name="clear" value="1" data-variant="ghost" data-busy>Schlüssel entfernen</button>{{end}}
      <button type="submit" data-busy>Speichern</button>
    </div>
  </form>
  <div class="ls-list sc-danger-zone"><button type="button" class="ls-row" data-tone="danger" data-ls-open="prov-del-{{.ID}}"><span class="ls-row-label">Anbieter löschen …</span></button></div>
</dialog>
<dialog class="ls-dialog" id="prov-del-{{.ID}}" aria-labelledby="prov-del-{{.ID}}-t">
  <form method="post" action="/llm/providers/{{.ID}}/delete">
    {{csrfField $.CSRFToken}}
    <h2 id="prov-del-{{.ID}}-t">{{.ID}} löschen?</h2>
    <p>Modelle, die auf diesen Anbieter zeigen, antworten danach nicht mehr.</p>
    <div class="ls-actions"><button type="button" data-variant="ghost" data-close>Abbrechen</button><button type="submit" data-variant="danger" data-busy>Löschen</button></div>
  </form>
</dialog>
{{end}}

{{/* ── Blätter: Modelle ──────────────────────────────────── */}}
<dialog class="ls-sheet" id="pers-new" aria-labelledby="pers-new-t">
  <form method="dialog" class="ls-sheet-bar"><button class="ls-iconbtn" aria-label="Schließen">{{template "icon" "x"}}</button></form>
  <div class="ls-sheet-hero"><h2 id="pers-new-t">Modell anlegen</h2><p>Unter diesem Namen sehen die Apps es.</p></div>
  <form method="post" action="/llm/personas" data-llm-form>
    {{csrfField .CSRFToken}}
    <div class="ls-list">
      <div class="ls-field"><label for="mn-id">Name für die Apps</label><input id="mn-id" name="id" required pattern="[a-z0-9][a-z0-9._-]*" placeholder="tutor-mathe" autocapitalize="none" spellcheck="false"></div>
      {{template "llm-model-fields" (llmModelCtx "mn" "" "" "" $.Providers)}}
    </div>
    <div class="ls-sheet-foot"><button type="button" data-variant="ghost" data-close>Abbrechen</button><button type="submit" data-busy>Anlegen</button></div>
  </form>
</dialog>

{{range .Personas}}
<dialog class="ls-sheet" id="pers-{{.ID}}" aria-labelledby="pers-{{.ID}}-t">
  <form method="dialog" class="ls-sheet-bar"><button class="ls-iconbtn" aria-label="Schließen">{{template "icon" "x"}}</button></form>
  <div class="ls-sheet-hero">
    <h2 id="pers-{{.ID}}-t">Modell „{{.ID}}“</h2>
    {{if and .Provider .UpstreamID}}<span class="ls-pill" data-tone="ok">aktiv</span>{{else}}<span class="ls-pill" data-tone="off">inaktiv</span>{{end}}
  </div>
  <form method="post" action="/llm/personas/{{.ID}}/update" data-llm-form>
    {{csrfField $.CSRFToken}}
    <div class="ls-list">
      {{template "llm-model-fields" (llmModelCtx .ID .Provider .UpstreamID .Prompt $.Providers)}}
    </div>
    <div class="ls-sheet-foot"><button type="submit" data-busy>Speichern</button></div>
  </form>
  {{if and .Provider .UpstreamID}}
  <form method="post" action="/llm/personas/{{.ID}}/deactivate" class="ls-list sc-gap-l">
    {{csrfField $.CSRFToken}}
    <button type="submit" class="ls-row" data-busy><span class="ls-row-label">Deaktivieren<small>Die Apps sehen das Modell nicht mehr. Die Anweisung bleibt erhalten.</small></span></button>
  </form>
  {{end}}
  <div class="ls-list sc-danger-zone"><button type="button" class="ls-row" data-tone="danger" data-ls-open="pers-del-{{.ID}}"><span class="ls-row-label">Modell löschen …</span></button></div>
</dialog>
<dialog class="ls-dialog" id="pers-del-{{.ID}}" aria-labelledby="pers-del-{{.ID}}-t">
  <form method="post" action="/llm/personas/{{.ID}}/delete">
    {{csrfField $.CSRFToken}}
    <h2 id="pers-del-{{.ID}}-t">„{{.ID}}“ löschen?</h2>
    <p>Apps, die dieses Modell benutzen, bekommen keine Antwort mehr.</p>
    <div class="ls-actions"><button type="button" data-variant="ghost" data-close>Abbrechen</button><button type="submit" data-variant="danger" data-busy>Löschen</button></div>
  </form>
</dialog>
{{end}}

{{/* ── Blätter: Schlüssel ────────────────────────────────── */}}
<dialog class="ls-sheet" id="key-new" aria-labelledby="key-new-t">
  <form method="dialog" class="ls-sheet-bar"><button class="ls-iconbtn" aria-label="Schließen">{{template "icon" "x"}}</button></form>
  <div class="ls-sheet-hero"><h2 id="key-new-t">Schlüssel erstellen</h2><p>Für eine App, die stackctl nicht selbst installiert hat.</p></div>
  <form method="post" action="/llm/keys">
    {{csrfField .CSRFToken}}
    <div class="ls-list">
      <div class="ls-field"><label for="kn-id">Wofür</label><input id="kn-id" name="id" required pattern="[a-z0-9][a-z0-9._-]*" placeholder="open-webui" autocapitalize="none" spellcheck="false"><span class="ls-field-hint">Nur zum Wiedererkennen in dieser Liste.</span></div>
    </div>
    {{if .Personas}}
    <span class="ls-list-label">Erlaubte Modelle</span>
    <div class="ls-list">
      {{range .Personas}}<label class="ls-row"><input type="checkbox" name="personas" value="{{.ID}}"><span class="ls-row-label">{{.ID}}</span></label>{{end}}
    </div>
    <p class="ls-list-hint">Nichts angehakt heißt: alle Modelle.</p>
    {{end}}
    <div class="ls-sheet-foot"><button type="button" data-variant="ghost" data-close>Abbrechen</button><button type="submit" data-busy>Erstellen</button></div>
  </form>
</dialog>

{{range .APIKeys}}
<dialog class="ls-dialog" id="key-del-{{.ID}}" aria-labelledby="key-del-{{.ID}}-t">
  <form method="post" action="/llm/keys/{{.ID}}/delete">
    {{csrfField $.CSRFToken}}
    <h2 id="key-del-{{.ID}}-t">Schlüssel „{{.ID}}“ sperren?</h2>
    <p>Wer ihn benutzt, bekommt sofort keine Antwort mehr vom KI-Dienst.</p>
    <div class="ls-actions"><button type="button" data-variant="ghost" data-close>Abbrechen</button><button type="submit" data-variant="danger" data-busy>Sperren</button></div>
  </form>
</dialog>
{{end}}

{{template "shell-end" .PageData}}
<script>
// Modell-Formulare: Wird ein Anbieter gewählt, holen wir dessen Modelle aus
// /llm/providers/{id}/models in die Vorschlagsliste. Klappt das nicht, bleibt
// das Feld frei beschreibbar.
(function () {
  async function loadModels(form) {
    var sel = form.querySelector('select[name="provider"]');
    var input = form.querySelector('input[name="upstream_id"]');
    var hint = form.querySelector('[data-llm-models-hint]');
    if (!sel || !input || !input.list) return;
    input.list.innerHTML = '';
    if (!sel.value) { hint.textContent = ''; return; }
    hint.textContent = 'Modelle werden geladen …';
    try {
      var resp = await fetch('/llm/providers/' + encodeURIComponent(sel.value) + '/models', { headers: { 'Accept': 'application/json' } });
      var body = await resp.json();
      if (body.error) { hint.textContent = 'Liste nicht abrufbar (' + body.error + '). Den Namen kannst du trotzdem eintippen.'; return; }
      (body.models || []).forEach(function (m) { var o = document.createElement('option'); o.value = m; input.list.appendChild(o); });
      hint.textContent = (body.models && body.models.length) ? body.models.length + ' Modelle zur Auswahl.' : 'Der Anbieter nennt keine Modelle. Den Namen kannst du eintippen.';
    } catch (err) {
      hint.textContent = 'Liste nicht abrufbar. Den Namen kannst du trotzdem eintippen.';
    }
  }
  document.addEventListener('change', function (ev) {
    if (ev.target.matches('form[data-llm-form] select[name="provider"]')) loadModels(ev.target.form);
  });
})();
</script>
{{template "foot" .}}
{{end}}

{{define "llm-model-fields"}}
<div class="ls-field"><label for="{{.Prefix}}-prov">Anbieter</label>
  <select id="{{.Prefix}}-prov" name="provider">
    <option value="">keiner (inaktiv)</option>
    {{$cur := .Provider}}{{range .Providers}}<option value="{{.ID}}"{{if eq .ID $cur}} selected{{end}}>{{.ID}}</option>{{end}}
  </select></div>
<div class="ls-field"><label for="{{.Prefix}}-up">Modell beim Anbieter</label>
  <input id="{{.Prefix}}-up" name="upstream_id" value="{{.UpstreamID}}" list="{{.Prefix}}-models" placeholder="gpt-4o-mini" autocapitalize="none" spellcheck="false">
  <datalist id="{{.Prefix}}-models"></datalist>
  <span class="ls-field-hint" data-llm-models-hint></span></div>
<div class="ls-field"><label for="{{.Prefix}}-prompt">Anweisung an die KI</label>
  <textarea id="{{.Prefix}}-prompt" name="prompt" placeholder="Leer lassen: Die App spricht direkt mit dem Modell.">{{.Prompt}}</textarea>
  <span class="ls-field-hint">Gilt für jede Anfrage über dieses Modell. Schüler:innen sehen sie nicht.</span></div>
{{end}}

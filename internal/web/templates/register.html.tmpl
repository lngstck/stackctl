{{define "page"}}
{{template "head" .}}

<div class="centered-box">
  <h1 class="mb-2" style="text-align:center;">
    <span class="wordmark wordmark--lg">
      <span class="wordmark__mark"></span>
      <span class="wordmark__name">learningstack</span>
      <span class="wordmark__app">stackctl</span>
    </span>
  </h1>

  <article class="card">
    <h3 class="mb-2">Registrierung</h3>
    <p class="mb-2">Das Setup ist abgeschlossen. Dein Server muss jetzt beim Betreiber freigeschaltet werden.</p>

    <div role="alert" data-variant="warning" class="mb-2">
      <strong>Naechster Schritt:</strong> Sende den Registrierungsblock an
      <code style="word-break:break-all;">registrierung@learningstack.online</code>.
    </div>

    <div class="hstack gap-2 mb-2">
      <a id="mailto-link" class="button" style="flex:1;text-align:center;">
        E-Mail senden
      </a>
      <a href="/setup/register/download" class="button ghost" style="flex:1;text-align:center;">
        Als Datei herunterladen
      </a>
    </div>

    <details class="mb-2">
      <summary class="sub" style="font-size:0.85rem;cursor:pointer;">Registrierungsblock anzeigen / kopieren</summary>
      <div style="position:relative;margin-top:0.5rem;">
        <pre id="age-block" style="background:var(--faint);padding:1rem;border-radius:0.5rem;font-size:0.75rem;overflow-x:auto;white-space:pre;user-select:all;">{{.AgeBlock}}</pre>
        <button type="button" class="ghost small" id="copy-btn"
          style="position:absolute;top:0.5rem;right:0.5rem;font-size:0.75rem;">
          Kopieren
        </button>
      </div>
    </details>

    <hr class="mb-2">

    <h4 class="mb-1">Status</h4>
    <div id="poll-status">
      <p class="sub">Warte auf Freischaltung…</p>
    </div>

    {{if .DevMode}}
    <hr class="mb-2">
    <form method="POST" action="/setup/register/skip">
      <button type="submit" class="ghost" style="width:100%;text-align:center;color:var(--danger);">
        Dev-Modus: Registrierung ueberspringen →
      </button>
    </form>
    {{end}}
  </article>
</div>

<script>
(function() {
  // --- Copy button ---
  var copyBtn = document.getElementById('copy-btn');
  var ageBlock = document.getElementById('age-block');
  copyBtn.addEventListener('click', function() {
    stackctlCopy(ageBlock.textContent.trim()).then(function() {
      copyBtn.textContent = 'Kopiert!';
      setTimeout(function() { copyBtn.textContent = 'Kopieren'; }, 2000);
    }, function(err) {
      copyBtn.textContent = 'Fehler';
      console.error('stackctlCopy:', err);
    });
  });

  // --- Mailto link with age block in body ---
  var subject = 'Learningstack Registrierung {{.SchoolSlug}}';
  var body =
    'Hallo learningstack-Team,\n\n' +
    'wir wuerden gerne die Schule "{{.SchoolName}}" ({{.SchoolSlug}}) ins learningstack-System aufnehmen.\n\n' +
    'Registrierungspaket:\n\n' +
    '{{jsString .AgeBlock}}\n\n' +
    'Hier kannst du etwas ueber dich als Admin und deine Schule schreiben:\n\n' +
    '...\n\n' +
    'Viele Gruesse';

  var link = document.getElementById('mailto-link');
  link.href = 'mailto:registrierung@learningstack.online'
    + '?subject=' + encodeURIComponent(subject)
    + '&body=' + encodeURIComponent(body);

  // --- Status polling ---
  var statusEl = document.getElementById('poll-status');
  function poll() {
    fetch('/setup/status')
      .then(function(resp) { return resp.json(); })
      .then(function(data) {
        if (data.status === 'ready') {
          statusEl.innerHTML =
            '<div role="alert" data-variant="success">' +
            'Freischaltung erfolgreich! Weiterleitung ...' +
            '</div>';
          setTimeout(function() { window.location.href = '/login'; }, 2000);
          return;
        }
        statusEl.innerHTML =
          '<p class="sub">' +
          'Dex-Tunnel: ' + (data.dex_tunnel ? '✓' : '✗') + '<br>' +
          'OIDC-Client: ' + (data.oidc_client ? '✓' : '✗') +
          '</p>';
        setTimeout(poll, 30000);
      })
      .catch(function() { setTimeout(poll, 30000); });
  }
  setTimeout(poll, 5000);
})();
</script>

{{template "foot" .}}
{{end}}

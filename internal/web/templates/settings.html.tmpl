{{define "page"}}
{{template "head" .}}
{{template "sidebar-layout-start" .}}

<h2 class="mb-2">Einstellungen</h2>

{{if .Error}}
<div role="alert" data-variant="danger" class="mb-2">{{.Error}}</div>
{{end}}
{{if .Message}}
<div role="alert" data-variant="success" class="mb-2">{{.Message}}</div>
{{end}}

<ot-tabs>
  <div role="tablist">
    <button role="tab" {{if not .SystemTabActive}}aria-selected="true"{{end}}>Allgemein</button>
    <button role="tab" {{if .SystemTabActive}}aria-selected="true"{{end}}>System</button>
  </div>

  <!-- Tab: Allgemein -->
  <div role="tabpanel">
    <article class="card mt-2">
      <form method="post" action="/settings">
        {{csrfField $.CSRFToken}}
        <h3 class="mb-2">Schule</h3>

        <label data-field class="mb-1">
          Schulname
          <input type="text" name="school_name" value="{{.SchoolName}}" required>
        </label>

        <label data-field class="mb-1">
          Schul-Slug
          <input type="text" value="{{.SchoolSlug}}" disabled>
          <span class="hint">Der Slug ist nach der Registrierung nicht mehr aenderbar. Er ist Teil der oeffentlichen URLs: <code>auth.<strong>{{.SchoolSlug}}</strong>.learningstack.online</code></span>
        </label>

        <label data-field class="mb-1">
          Server-IP / Hostname
          <input type="text" name="server_domain" value="{{.ServerDomain}}">
          <span class="hint">LAN-Adresse dieses Servers (fuer lokale App-Links).</span>
        </label>

        <label data-field class="mb-2">
          Kontakt-E-Mail
          <input type="email" name="contact_email" value="{{.ContactEmail}}" placeholder="admin@schule.de">
        </label>

        <h3 class="mb-2">Admin-Passwort aendern <span class="sub" style="font-size:0.85rem;">(optional)</span></h3>

        <label data-field class="mb-1">
          Neues Passwort
          <input type="password" name="password" minlength="8" autocomplete="new-password">
          <span class="hint">Leer lassen, um das aktuelle Passwort zu behalten. Neues Passwort meldet alle anderen Sessions ab.</span>
        </label>

        <label data-field class="mb-2">
          Passwort wiederholen
          <input type="password" name="password_confirm" minlength="8" autocomplete="new-password">
        </label>

        <h3 class="mb-2">Automatische Updates</h3>
        <label data-field class="mb-2">
          <input type="checkbox" name="auto_update" {{if .AutoUpdate}}checked{{end}}>
          Naechtliche Auto-Updates aktivieren
          <span class="hint">stackctl prueft jede Nacht den Katalog und installiert nicht-kritische Updates automatisch. Apps mit Breaking-Marker und manuell deaktivierte Apps bleiben unangetastet.</span>
        </label>

        <h3 class="mb-2">Dex-Upstream</h3>
        <p class="sub mb-2">Aktuell fest auf <strong>moin.schule</strong> via zentralem Dex konfiguriert. Dex-URL: <code>{{.DexAuthURL}}</code></p>

        <button type="submit" class="mt-1">Speichern</button>
      </form>
    </article>
  </div>

  <!-- Tab: System (ehemals /system, Issue #4) -->
  <div role="tabpanel">
    {{if .SyncResult}}
      <div role="alert" data-variant="success" class="mt-2 mb-2">{{.SyncResult}}</div>
    {{end}}
    {{if .SyncError}}
      <div role="alert" data-variant="danger" class="mt-2 mb-2">{{.SyncError}}</div>
    {{end}}
    {{if .UpdateResult}}
      <div role="alert" data-variant="success" class="mt-2 mb-2">
        {{.UpdateResult}}
        {{if .Restarting}}<br><span class="sub">Die Seite lädt automatisch neu, sobald der Dienst wieder erreichbar ist…</span>{{end}}
      </div>
    {{end}}
    {{if .UpdateError}}
      <div role="alert" data-variant="danger" class="mt-2 mb-2">{{.UpdateError}}</div>
    {{end}}

    {{if .Restarting}}
    <script>
    // Nach dem Self-Update beendet sich der Prozess (os.Exit) und systemd
    // bringt ihn mit dem neuen Binary wieder hoch. Wir pollen /healthz und
    // laden neu, sobald der Dienst NACH einem Ausfall wieder antwortet — so
    // sieht der Admin direkt die neue Version statt auf "Neustart..." kleben
    // zu bleiben. wasDown verhindert ein zu fruehes Reload, solange der alte
    // Prozess noch antwortet.
    (function() {
      var wasDown = false, start = Date.now();
      var done = '/settings?update=' + encodeURIComponent('Aktualisierung abgeschlossen.');
      function poll() {
        if (Date.now() - start > 60000) { window.location.href = done; return; }
        fetch('/healthz', { cache: 'no-store' })
          .then(function(r) {
            if (r.ok && wasDown) { window.location.href = done; return; }
            if (!r.ok) wasDown = true;
            setTimeout(poll, 1000);
          })
          .catch(function() { wasDown = true; setTimeout(poll, 1000); });
      }
      setTimeout(poll, 1500);
    })();
    </script>
    {{end}}

    <style>
      /* --muted is oat's surface colour (near-white in light mode); the
         readable secondary-text colour is --muted-foreground. Use the same
         foreground-mix as .sub so the values stay legible in both themes. */
      .sysmeter { background:var(--muted); border-radius:0.4rem; height:0.7rem; overflow:hidden; }
      .sysmeter > span { display:block; height:100%; border-radius:0.4rem; transition:width .3s ease; }
      .sysmeter > span.ok { background:var(--success); }
      .sysmeter > span.warn { background:var(--warning); }
      .sysmeter > span.crit { background:var(--danger); }
      .sysrow { margin-bottom:1rem; }
      .sysrow:last-child { margin-bottom:0; }
      .sysrow .lbl { display:flex; justify-content:space-between; align-items:baseline; font-size:0.92rem; margin-bottom:0.3rem; }
      .sysrow .lbl .val { font-variant-numeric:tabular-nums; color:var(--muted-foreground); font-size:0.85rem; }
      .sysrow .free { font-size:0.8rem; color:var(--muted-foreground); margin-top:0.25rem; }
    </style>

    <article class="card mt-2">
      <h4 class="mb-2">System-Auslastung</h4>
      {{if .Sys.Available}}
        {{if .Sys.RAMOK}}
        <div class="sysrow">
          <div class="lbl"><span>Arbeitsspeicher</span><span class="val">{{.Sys.RAMUsed}} / {{.Sys.RAMTotal}} · {{.Sys.RAMPercent}}%</span></div>
          <div class="sysmeter"><span class="{{.Sys.RAMLevel}}" style="width:{{.Sys.RAMPercent}}%"></span></div>
          <div class="free">{{.Sys.RAMFree}} frei</div>
        </div>
        {{end}}
        {{if .Sys.DiskOK}}
        <div class="sysrow">
          <div class="lbl"><span>Speicherplatz</span><span class="val">{{.Sys.DiskUsed}} / {{.Sys.DiskTotal}} · {{.Sys.DiskPercent}}%</span></div>
          <div class="sysmeter"><span class="{{.Sys.DiskLevel}}" style="width:{{.Sys.DiskPercent}}%"></span></div>
          <div class="free">{{.Sys.DiskFree}} frei{{if .Sys.DiskPath}} · {{.Sys.DiskPath}}{{end}}</div>
        </div>
        {{end}}
        {{if or .Sys.CPUCount .Sys.LoadOK}}
        <p class="free" style="margin-top:0.8rem;">
          {{if .Sys.CPUCount}}{{.Sys.CPUCount}} CPU-Kerne{{end}}{{if .Sys.LoadOK}} · Auslastung (1 min): {{.Sys.Load1}}{{end}}
        </p>
        {{end}}
      {{else}}
        <p class="sub" style="margin:0;">Systeminformationen sind auf dieser Plattform nicht verfügbar.</p>
      {{end}}
    </article>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;" class="mt-2">
      <article class="card">
        <h4 class="mb-1">stackctl</h4>
        <table style="width:100%;" class="mb-2">
          <tr>
            <td class="sub">Installierte Version</td>
            <td><strong>{{.CurrentVersion}}</strong></td>
          </tr>
          {{if .LatestVersion}}
          <tr>
            <td class="sub">Neueste Version</td>
            <td>
              {{.LatestVersion}}
              {{if .UpdateAvailable}}
                <span class="badge" style="margin-left:0.5rem;">Update verfuegbar</span>
              {{end}}
            </td>
          </tr>
          {{end}}
          {{if .CheckError}}
          <tr>
            <td class="sub">Update-Check</td>
            <td style="color:var(--danger);">{{.CheckError}}</td>
          </tr>
          {{end}}
        </table>

        {{if .UpdateAvailable}}
          <form method="POST" action="/system/update"
                data-loading-msg="Aktualisiere… (Download + Restart)"
                onsubmit="return confirm('Update auf {{.LatestVersion}} installieren? stackctl wird kurz neu gestartet.');">
        {{csrfField $.CSRFToken}}
            <button type="submit">Update installieren</button>
          </form>
        {{else if not .CheckError}}
          <p class="sub" style="font-size:0.85rem;">stackctl ist aktuell.</p>
        {{end}}
      </article>

      <article class="card">
        <h4 class="mb-1">App-Katalog</h4>
        <p class="sub mb-2" style="font-size:0.85rem;">
          Katalog von <code>{{.SchoolSlug}}</code> synchronisieren, um neue Apps und Updates zu sehen.
        </p>
        <form method="POST" action="/system/catalog/sync"
              data-loading-msg="Synchronisiere…">
        {{csrfField $.CSRFToken}}
          <button type="submit" class="small">Katalog synchronisieren</button>
        </form>
      </article>
    </div>
  </div>
</ot-tabs>

{{template "sidebar-layout-end" .}}
{{template "foot" .}}
{{end}}

{{define "head"}}
<!DOCTYPE html>
<html lang="de" data-app="stackctl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{block "title" .}}{{end}} · stackctl</title>
  {{/* Erzwungenen Hell/Dunkel-Modus vor dem ersten Bild setzen, sonst
       blitzt die Seite im falschen Modus auf. Wählen lässt er sich im
       Kontomenü, gemerkt wird er von learningstack.js. */}}
  <script>try{var t=localStorage.getItem('ls-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="stylesheet" href="{{asset "/static/ls/learningstack.css"}}">
  <link rel="stylesheet" href="{{asset "/static/stackctl.css"}}">
  <script src="{{asset "/static/ls/js/learningstack.js"}}" defer></script>
  <script src="{{asset "/static/stackctl.js"}}" defer></script>
</head>
{{end}}

{{define "foot"}}
{{block "scripts" .}}{{end}}
</body>
</html>
{{end}}

{{/* Plattform-Rahmen: Dock, Kopfzeile, Inhalt. .PageData muss übergeben
     werden. Die Suche steht nur auf Seiten, deren Inhalt sie filtert. */}}
{{define "shell-start"}}
<body class="ls-shell"{{if .OpenSheet}} data-open="{{.OpenSheet}}"{{end}}>
<a class="ls-skip" href="#inhalt">Zum Inhalt</a>

<nav class="ls-dock" aria-label="Bereiche">
  <a href="/" {{activeNav .NavActive "dashboard"}}>{{template "dock-icon" "grid"}}Start</a>
  <a href="/apps" {{activeNav .NavActive "apps"}}>{{template "dock-icon" "bag"}}Katalog</a>
  <a href="/public" {{activeNav .NavActive "public"}}>{{template "dock-icon" "shield"}}Zugang</a>
  <a href="/backups" {{activeNav .NavActive "backups"}}>{{template "dock-icon" "archive"}}Sicherung</a>
  {{if .LLMInstalled}}<a href="/llm" {{activeNav .NavActive "llm"}}>{{template "dock-icon" "spark"}}KI</a>{{end}}
  <a href="/settings" {{activeNav .NavActive "settings"}}>{{template "dock-icon" "gear"}}Einstellungen</a>
</nav>

<div class="ls-page">
  <header class="ls-top">
    <a class="ls-wordmark" href="/"><svg class="ls-mark" aria-hidden="true"><use href="/static/ls/icons/icons.svg#mark"/></svg>learningstack</a>
    {{if .Search}}
    <label class="ls-search">{{template "icon" "search"}}<span class="ls-sr">App suchen</span><input type="search" placeholder="App suchen" data-ls-filter autocomplete="off"><kbd>/</kbd></label>
    {{end}}
    <div class="ls-top-end">
      <span class="ls-hide-s">{{.SchoolName}}</span>
      <button type="button" class="ls-avatar sc-account" popovertarget="sc-account" aria-label="Konto und Darstellung">{{template "icon" "user"}}</button>
      <div class="sc-menu" id="sc-account" popover>
        <span class="ls-list-label">Darstellung</span>
        <div class="ls-seg" role="group" aria-label="Darstellung">
          <button type="button" data-ls-theme="system">System</button>
          <button type="button" data-ls-theme="light">Hell</button>
          <button type="button" data-ls-theme="dark">Dunkel</button>
        </div>
        <form method="post" action="/logout">
          {{csrfField .CSRFToken}}
          <button type="submit" data-variant="ghost">{{template "icon" "logout"}}Abmelden</button>
        </form>
      </div>
    </div>
  </header>

  <main class="ls-main" id="inhalt">
{{end}}

{{define "shell-end"}}
  </main>
</div>
{{end}}

{{/* Seiten ohne Dock: Anmelden, Einrichtung. */}}
{{define "bare-start"}}
<body class="sc-bare">
<main class="sc-bare-main" id="inhalt">
  <a class="ls-wordmark sc-bare-mark" href="/"><svg class="ls-mark" aria-hidden="true"><use href="/static/ls/icons/icons.svg#mark"/></svg>learningstack</a>
{{end}}

{{define "bare-end"}}
</main>
{{end}}

{{define "icon"}}<svg class="ls-icon" aria-hidden="true"><use href="/static/ls/icons/icons.svg#{{.}}"/></svg>{{end}}
{{define "dock-icon"}}<svg aria-hidden="true"><use href="/static/ls/icons/icons.svg#{{.}}"/></svg>{{end}}

{{/* Kachel einer App. Erwartet ein appTile (handlers_start.go). */}}
{{define "tile"}}<span class="ls-tile"{{if .Size}} data-size="{{.Size}}"{{end}}{{if .Face.Own}} data-app="{{.Face.ID}}"{{else}} style="--ls-hue: {{.Face.Hue}}"{{end}}{{if .Off}} data-state="off"{{end}}>{{if .Face.Icon}}<svg aria-hidden="true"><use href="/static/ls/icons/icons.svg#{{.Face.Icon}}"/></svg>{{else}}<b>{{.Face.Abbr}}</b>{{end}}{{if .Alert}}<span class="ls-badge" data-kind="alert">{{template "dock-icon" "alert"}}</span>{{else if .Update}}<span class="ls-badge" data-kind="update">{{template "dock-icon" "update"}}</span>{{end}}{{if .Internet}}<span class="ls-badge" data-kind="internet">{{template "dock-icon" "globe"}}</span>{{end}}{{if .Installed}}<span class="ls-badge" data-kind="installed">{{template "dock-icon" "check"}}</span>{{end}}</span>{{end}}

{{/* Hinweis mit genau einer Handlung. Erwartet ein notice. */}}
{{define "notice"}}
<article class="ls-card ls-notice" data-tone="{{.Tone}}">
  {{if .Tile}}{{template "tile" .Tile}}{{else}}<span class="ls-notice-icon">{{template "dock-icon" .Icon}}</span>{{end}}
  <h3>{{if .Sheet}}<button type="button" data-ls-open="{{.Sheet}}">{{.Title}}</button>{{else if .Href}}<a href="{{.Href}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}</h3>
  {{if .Detail}}<p>{{.Detail}}</p>{{end}}
  {{if .ActionLabel}}
  <div class="ls-actions">
    {{if .PostTo}}
    <form method="post" action="{{.PostTo}}">{{csrfField .CSRFToken}}<button type="submit" data-size="s" data-busy>{{.ActionLabel}}</button></form>
    {{else if .Sheet}}
    <button type="button" data-size="s" data-variant="ghost" data-ls-open="{{.Sheet}}">{{.ActionLabel}}</button>
    {{else}}
    <a class="ls-btn" data-size="s" data-variant="ghost" href="{{.Href}}">{{.ActionLabel}}</a>
    {{end}}
  </div>
  {{end}}
</article>
{{end}}

{{/* Kurze Rückmeldung nach einer Aktion: Erfolg ruhig, Fehler rot. */}}
{{define "flash"}}{{if .Text}}<p class="sc-flash" data-tone="{{if .Err}}bad{{else}}ok{{end}}" role="{{if .Err}}alert{{else}}status{{end}}">{{template "icon" (or (and .Err "alert") "check-circle")}}<span>{{.Text}}</span></p>{{end}}{{end}}

{{define "copy-btn"}}<button type="button" class="sc-copy" data-copy="{{.}}" aria-label="Kopieren" title="Kopieren">{{template "icon" "copy"}}</button>{{end}}

{{define "where"}}{{if eq . "internet"}}<span class="ls-where" data-where="internet">{{template "dock-icon" "globe"}}Internet</span>{{else}}<span class="ls-where" data-where="school">{{template "dock-icon" "school"}}Schulnetz</span>{{end}}{{end}}

{{/* Blatt einer installierten App, auf Start und im Katalog. Erwartet
   sheetCtx: .App, .CSRFToken, .Mode */}}
{{define "app-sheet"}}
{{$a := .App}}{{$csrf := .CSRFToken}}{{$back := .Back}}
<dialog class="ls-sheet" id="app-{{$a.ID}}" aria-labelledby="app-{{$a.ID}}-title">
  <form method="dialog" class="ls-sheet-bar"><button class="ls-iconbtn" aria-label="Schließen">{{template "icon" "x"}}</button></form>
  <div class="ls-sheet-hero">
    {{template "tile" (tileSize $a.Tile "")}}
    <h2 id="app-{{$a.ID}}-title">{{$a.Name}}</h2>
    {{if $a.Description}}<p>{{$a.Description}}</p>{{end}}
    {{if $a.Running}}<span class="ls-pill" data-tone="ok">läuft</span>{{else}}<span class="ls-pill" data-tone="bad">aus</span>{{end}}
    <div class="ls-actions">
      {{if and $a.OpenURL $a.Running}}<a class="ls-btn" href="{{$a.OpenURL}}" target="_blank" rel="noopener">{{template "icon" "external"}}Öffnen</a>{{end}}
      {{if $a.UpdateTo}}
      <form method="post" action="/apps/{{$a.ID}}/update">{{csrfField $csrf}}<button type="submit" data-variant="{{if $a.OpenURL}}ghost{{end}}" data-busy>{{template "icon" "update"}}Auf {{$a.UpdateTo}} aktualisieren</button></form>
      {{end}}
      {{if $a.Running}}
      <form method="post" action="/apps/{{$a.ID}}/stop">{{csrfField $csrf}}<input type="hidden" name="return" value="{{$back}}"><button type="submit" data-variant="ghost" data-busy>{{template "icon" "power"}}Ausschalten</button></form>
      {{else}}
      <form method="post" action="/apps/{{$a.ID}}/start">{{csrfField $csrf}}<input type="hidden" name="return" value="{{$back}}"><button type="submit" data-busy>{{template "icon" "power"}}Einschalten</button></form>
      {{end}}
    </div>
  </div>

  {{if $a.IsMandatory}}
  <p class="sc-sheet-note">{{template "icon" "info"}}<span>{{$a.Name}} gehört zur Grundversorgung. Ausgeschaltet funktionieren andere Apps nicht mehr.</span></p>
  {{end}}

  {{if or $a.CanPublish $a.PublicEnabled}}
  <span class="ls-list-label">Adresse</span>
  <div class="ls-list">
    {{if $a.PublicEnabled}}
    <a class="ls-row" href="https://{{$a.PublicHost}}" target="_blank" rel="noopener"><span class="ls-row-label">{{$a.PublicHost}}<small>{{if eq .Mode "direct"}}Von überall erreichbar, für alle mit Schulkonto.{{else}}Im Schulnetz, für alle mit Schulkonto.{{end}}</small></span>{{template "where" $a.Where}}</a>
    {{else}}
    <div class="ls-row"><span class="ls-row-label">Keine Adresse<small>So erreicht niemand die App.</small></span></div>
    {{end}}
    <form method="post" action="/apps/{{$a.ID}}/public/{{if $a.PublicEnabled}}disable{{else}}enable{{end}}" class="ls-row sc-row-form">
      {{csrfField $csrf}}<input type="hidden" name="return" value="{{$back}}">
      <span class="ls-row-label">Adresse {{if $a.PublicEnabled}}abschalten{{else}}einschalten{{end}}{{if $a.PublicEnabled}}<small>Danach erreicht niemand mehr die App.</small>{{end}}</span>
      <button type="submit" data-size="s" data-variant="{{if $a.PublicEnabled}}ghost{{end}}" data-busy>{{if $a.PublicEnabled}}Abschalten{{else}}Einschalten{{end}}</button>
    </form>
  </div>
  {{end}}

  <span class="ls-list-label">Updates</span>
  <div class="ls-list">
    <div class="ls-row"><span class="ls-row-label">Version</span><span class="ls-row-value">{{$a.Version}}{{if $a.UpdateTo}} → {{$a.UpdateTo}}{{end}}</span></div>
    <form method="post" action="/apps/{{$a.ID}}/autoupdate" class="ls-row sc-row-form" data-autosubmit>
      {{csrfField $csrf}}<input type="hidden" name="return" value="{{$back}}">
      <label class="sc-switch-row"><span class="ls-row-label">Automatisch aktualisieren<small>Nachts, wenn es in den Einstellungen eingeschaltet ist. Größere Updates nie automatisch.</small></span>
      <input type="checkbox" role="switch" name="auto"{{if $a.AutoUpdate}} checked{{end}}></label>
      <noscript><button type="submit" data-size="s" data-variant="ghost">Speichern</button></noscript>
    </form>
  </div>
  {{if $a.UpdateBreaking}}<p class="ls-list-hint">Das Update auf {{$a.UpdateTo}} ist größer, zum Beispiel mit Umbau der Datenbank. Vorher eine <a href="/backups">Sicherung</a> anlegen.</p>{{end}}

  {{if $a.HasOIDC}}
  <span class="ls-list-label">Anmeldung mit Schulkonto</span>
  <div class="ls-list">
    <div class="ls-row"><span class="ls-row-label">Client-ID<small><code>{{$a.OIDCClientID}}</code></small></span>{{template "copy-btn" $a.OIDCClientID}}</div>
    <div class="ls-row"><span class="ls-row-label">Weiterleitung<small class="sc-break"><code>{{$a.OIDCRedirectURI}}</code></small></span>{{template "copy-btn" $a.OIDCRedirectURI}}</div>
  </div>
  {{end}}

  {{if or $a.AdminLogin $a.AdminPassword $a.AdminNotes}}
  <span class="ls-list-label">Verwaltung der App</span>
  <div class="ls-list">
    {{if $a.AdminLogin}}<div class="ls-row"><span class="ls-row-label">Benutzer<small><code>{{$a.AdminLogin}}</code></small></span>{{template "copy-btn" $a.AdminLogin}}</div>{{end}}
    {{if $a.AdminPassword}}<div class="ls-row"><span class="ls-row-label">Passwort<small>{{$a.AdminPassword}}</small></span></div>{{end}}
  </div>
  {{if $a.AdminNotes}}<p class="ls-list-hint sc-pre">{{$a.AdminNotes}}</p>{{end}}
  {{end}}

  <span class="ls-list-label">Für Fortgeschrittene</span>
  <div class="ls-list">
    <details><summary class="ls-row"><span class="ls-row-label">Technische Angaben</span></summary>
      <dl class="sc-tech">
        <dt>Container</dt><dd><code>{{$a.ContainerName}}</code></dd>
        {{if $a.Port}}<dt>Port</dt><dd><code>{{$a.Port}}</code></dd>{{end}}
        <dt>Daten</dt><dd><code>{{$a.DataDir}}</code></dd>
        {{if $a.InstalledAt}}<dt>Installiert</dt><dd>{{$a.InstalledAt}}</dd>{{end}}
      </dl>
    </details>
    {{if $a.Homepage}}<a class="ls-row" href="{{$a.Homepage}}" target="_blank" rel="noopener"><span class="ls-row-label">Webseite der App</span>{{template "icon" "external"}}</a>{{end}}
    {{if $a.Docs}}<a class="ls-row" href="{{$a.Docs}}" target="_blank" rel="noopener"><span class="ls-row-label">Anleitung</span>{{template "icon" "external"}}</a>{{end}}
  </div>

  <div class="ls-list sc-danger-zone"><button type="button" class="ls-row" data-tone="danger" data-ls-open="remove-{{$a.ID}}"><span class="ls-row-label">{{$a.Name}} entfernen …</span></button></div>
</dialog>

<dialog class="ls-dialog" id="remove-{{$a.ID}}" aria-labelledby="remove-{{$a.ID}}-title">
  <form method="post" action="/apps/{{$a.ID}}/remove">
    {{csrfField $csrf}}
    <h2 id="remove-{{$a.ID}}-title">{{$a.Name}} entfernen?</h2>
    {{if $a.IsMandatory}}<p class="sc-warn">{{$a.Name}} gehört zur Grundversorgung. Ohne ihn funktionieren andere Apps nicht mehr.</p>{{end}}
    <p>Die App verschwindet für alle. Ihre Daten bleiben auf dem Server und werden bei einer neuen Installation wieder benutzt.</p>
    <label class="sc-check"><input type="checkbox" name="wipe_data"><span>Auch die Daten löschen<small>Datenbank und <code>{{$a.DataDir}}</code>. Das lässt sich nicht rückgängig machen.</small></span></label>
    <div class="ls-actions">
      <button type="button" data-variant="ghost" data-close>Abbrechen</button>
      <button type="submit" data-variant="danger" data-busy>Entfernen</button>
    </div>
  </form>
</dialog>
{{end}}

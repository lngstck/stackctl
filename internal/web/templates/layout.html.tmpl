{{define "head"}}
<!DOCTYPE html>
<html lang="de" data-app="stackctl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{block "title" .}}{{end}} · stackctl</title>
  {{/* Erzwungenen Hell/Dunkel-Modus vor dem ersten Bild setzen, sonst
       blitzt die Seite im falschen Modus auf. Wählen lässt er sich im
       Kontomenü, gemerkt wird er von learningstack.js. */}}
  <script>try{var t=localStorage.getItem('ls-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>
  <link rel="stylesheet" href="{{asset "/static/ls/learningstack.css"}}">
  <link rel="stylesheet" href="{{asset "/static/stackctl.css"}}">
  <script src="{{asset "/static/ls/js/learningstack.js"}}" defer></script>
  <script src="{{asset "/static/stackctl.js"}}" defer></script>
</head>
{{end}}

{{define "foot"}}
{{block "scripts" .}}{{end}}
</body>
</html>
{{end}}

{{/* Plattform-Rahmen: Dock, Kopfzeile, Inhalt. .PageData muss übergeben
     werden. Die Suche steht nur auf Seiten, deren Inhalt sie filtert. */}}
{{define "shell-start"}}
<body class="ls-shell"{{if .OpenSheet}} data-open="{{.OpenSheet}}"{{end}}>
<a class="ls-skip" href="#inhalt">Zum Inhalt</a>

<nav class="ls-dock" aria-label="Bereiche">
  <a href="/" {{activeNav .NavActive "dashboard"}}>{{template "dock-icon" "grid"}}Start</a>
  <a href="/apps" {{activeNav .NavActive "apps"}}>{{template "dock-icon" "bag"}}Katalog</a>
  <a href="/public" {{activeNav .NavActive "public"}}>{{template "dock-icon" "shield"}}Zugang</a>
  <a href="/backups" {{activeNav .NavActive "backups"}}>{{template "dock-icon" "archive"}}Sicherung</a>
  {{if .LLMInstalled}}<a href="/llm" {{activeNav .NavActive "llm"}}>{{template "dock-icon" "spark"}}KI</a>{{end}}
  <a href="/settings" {{activeNav .NavActive "settings"}}>{{template "dock-icon" "gear"}}Einstellungen</a>
</nav>

<div class="ls-page">
  <header class="ls-top">
    <a class="ls-wordmark" href="/"><svg class="ls-mark" aria-hidden="true"><use href="/static/ls/icons/icons.svg#mark"/></svg>learningstack</a>
    {{if .Search}}
    <label class="ls-search">{{template "icon" "search"}}<span class="ls-sr">App suchen</span><input type="search" placeholder="App suchen" data-ls-filter autocomplete="off"><kbd>/</kbd></label>
    {{end}}
    <div class="ls-top-end">
      <span class="ls-hide-s">{{.SchoolName}}</span>
      <button type="button" class="ls-avatar sc-account" popovertarget="sc-account" aria-label="Konto und Darstellung">{{template "icon" "user"}}</button>
      <div class="sc-menu" id="sc-account" popover>
        <span class="ls-list-label">Darstellung</span>
        <div class="ls-seg" role="group" aria-label="Darstellung">
          <button type="button" data-ls-theme="system">System</button>
          <button type="button" data-ls-theme="light">Hell</button>
          <button type="button" data-ls-theme="dark">Dunkel</button>
        </div>
        <form method="post" action="/logout">
          {{csrfField .CSRFToken}}
          <button type="submit" data-variant="ghost">{{template "icon" "logout"}}Abmelden</button>
        </form>
      </div>
    </div>
  </header>

  <main class="ls-main" id="inhalt">
{{end}}

{{define "shell-end"}}
  </main>
</div>
{{end}}

{{/* Seiten ohne Dock: Anmelden, Einrichtung. */}}
{{define "bare-start"}}
<body class="sc-bare">
<main class="sc-bare-main" id="inhalt">
  <a class="ls-wordmark sc-bare-mark" href="/"><svg class="ls-mark" aria-hidden="true"><use href="/static/ls/icons/icons.svg#mark"/></svg>learningstack</a>
{{end}}

{{define "bare-end"}}
</main>
{{end}}

{{define "icon"}}<svg class="ls-icon" aria-hidden="true"><use href="/static/ls/icons/icons.svg#{{.}}"/></svg>{{end}}
{{define "dock-icon"}}<svg aria-hidden="true"><use href="/static/ls/icons/icons.svg#{{.}}"/></svg>{{end}}

{{/* Kachel einer App. Erwartet ein appTile (handlers_start.go). */}}
{{define "tile"}}<span class="ls-tile"{{if .Size}} data-size="{{.Size}}"{{end}}{{if .Face.Own}} data-app="{{.Face.ID}}"{{else}} style="--ls-hue: {{.Face.Hue}}"{{end}}{{if .Off}} data-state="off"{{end}}>{{if .Face.Icon}}<svg aria-hidden="true"><use href="/static/ls/icons/icons.svg#{{.Face.Icon}}"/></svg>{{else}}<b>{{.Face.Abbr}}</b>{{end}}{{if .Alert}}<span class="ls-badge" data-kind="alert">{{template "dock-icon" "alert"}}</span>{{else if .Update}}<span class="ls-badge" data-kind="update">{{template "dock-icon" "update"}}</span>{{end}}{{if .Internet}}<span class="ls-badge" data-kind="internet">{{template "dock-icon" "globe"}}</span>{{end}}</span>{{end}}

{{/* Hinweis mit genau einer Handlung. Erwartet ein notice. */}}
{{define "notice"}}
<article class="ls-card ls-notice" data-tone="{{.Tone}}">
  {{if .Tile}}{{template "tile" .Tile}}{{else}}<span class="ls-notice-icon">{{template "dock-icon" .Icon}}</span>{{end}}
  <h3>{{if .Sheet}}<button type="button" data-ls-open="{{.Sheet}}">{{.Title}}</button>{{else if .Href}}<a href="{{.Href}}">{{.Title}}</a>{{else}}{{.Title}}{{end}}</h3>
  {{if .Detail}}<p>{{.Detail}}</p>{{end}}
  {{if .ActionLabel}}
  <div class="ls-actions">
    {{if .PostTo}}
    <form method="post" action="{{.PostTo}}">{{csrfField .CSRFToken}}<button type="submit" data-size="s" data-busy>{{.ActionLabel}}</button></form>
    {{else if .Sheet}}
    <button type="button" data-size="s" data-variant="ghost" data-ls-open="{{.Sheet}}">{{.ActionLabel}}</button>
    {{else}}
    <a class="ls-btn" data-size="s" data-variant="ghost" href="{{.Href}}">{{.ActionLabel}}</a>
    {{end}}
  </div>
  {{end}}
</article>
{{end}}

{{/* Kurze Rückmeldung nach einer Aktion: Erfolg ruhig, Fehler rot. */}}
{{define "flash"}}{{if .Text}}<p class="sc-flash" data-tone="{{if .Err}}bad{{else}}ok{{end}}" role="{{if .Err}}alert{{else}}status{{end}}">{{template "icon" (or (and .Err "alert") "check-circle")}}<span>{{.Text}}</span></p>{{end}}{{end}}

{{define "copy-btn"}}<button type="button" class="sc-copy" data-copy="{{.}}" aria-label="Kopieren" title="Kopieren">{{template "icon" "copy"}}</button>{{end}}

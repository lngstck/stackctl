{{define "head"}}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>stackctl</title>
  <link rel="stylesheet" href="/static/oat.min.css">
  <link rel="stylesheet" href="/static/stackctl.css">
</head>
<body>
{{end}}

{{define "foot"}}
<script src="/static/oat.min.js"></script>
<script>
// Clipboard helper with execCommand fallback. Needed because
// navigator.clipboard is only available in secure contexts (HTTPS or
// localhost); stackctl is usually reached via http://<LAN-IP>:8090, where
// the modern API is blocked silently.
window.stackctlCopy = function(text) {
  if (navigator.clipboard && window.isSecureContext) {
    return navigator.clipboard.writeText(text);
  }
  return new Promise(function(resolve, reject) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.top = '0';
    ta.style.left = '0';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try {
      var ok = document.execCommand('copy');
      document.body.removeChild(ta);
      ok ? resolve() : reject(new Error('execCommand returned false'));
    } catch (err) {
      document.body.removeChild(ta);
      reject(err);
    }
  });
};

// Delegierter Handler fuer <button data-copy="...">: kopiert den Wert ins
// Clipboard und zeigt kurzes "Kopiert ✓"-Feedback. Wert kommt aus dem
// data-Attribut — kein onclick-Inlining, das spart manuelles Escapen.
document.addEventListener('click', function(ev) {
  var btn = ev.target.closest('[data-copy]');
  if (!btn) return;
  ev.preventDefault();
  var text = btn.getAttribute('data-copy');
  var original = btn.textContent;
  stackctlCopy(text).then(function() {
    btn.textContent = 'Kopiert ✓';
    setTimeout(function() { btn.textContent = original; }, 1500);
  }).catch(function(err) {
    console.error('copy failed:', err);
    btn.textContent = 'Fehler';
    setTimeout(function() { btn.textContent = original; }, 1500);
  });
});

// Loading-State fuer synchrone, lang laufende POSTs (Install, Update,
// Remove — docker compose pull kann Minuten dauern, siehe #1). Forms,
// die `data-loading-msg="..."` setzen, bekommen ihren Submit-Button auf
// disabled und den Button-Text auf die Nachricht — verhindert Doppel-
// Submit und macht das Warten erklaerlich. Greift erst nach onsubmit-
// confirm(), weil der 'submit'-Event nur feuert wenn confirm true ergab.
document.addEventListener('submit', function(ev) {
  var form = ev.target;
  if (!form.matches || !form.matches('form[data-loading-msg]')) return;
  var btn = form.querySelector('button[type=submit], button:not([type])');
  if (!btn) return;
  btn.disabled = true;
  btn.textContent = form.getAttribute('data-loading-msg');
});
</script>
{{block "scripts" .}}{{end}}
</body>
</html>
{{end}}

{{define "copy-btn"}}<button type="button" class="ghost small" data-copy="{{.}}" style="margin-left:0.5rem;font-size:0.75rem;padding:0.1rem 0.5rem;">Kopieren</button>{{end}}


{{define "title"}}Start{{end}}
{{define "page"}}
{{template "head" .}}
{{template "shell-start" .PageData}}

<div class="ls-hello">
  <h1>{{.Headline}}</h1>
  <p>{{.Summary}}</p>
</div>

{{template "flash" .Flash}}

{{if .Notices}}
<h2 class="ls-sr">Braucht dich</h2>
<section class="ls-attention" aria-label="Braucht dich">
  {{range .Notices}}{{template "notice" .}}{{end}}
</section>
{{end}}

<section class="ls-widgets" aria-label="Server">
  <div class="ls-card ls-widget">
    <header>{{template "icon" "server"}}Arbeitsspeicher</header>
    {{if .Sys.RAMOK}}
    <div class="ls-widget-value">{{.Sys.RAMUsedShort}} <small>von {{.Sys.RAMTotalShort}}</small></div>
    <meter min="0" max="100" value="{{.Sys.RAMPercent}}" low="75" high="90" optimum="0" aria-label="Arbeitsspeicher belegt"></meter>
    <p>{{.Sys.RAMFreeShort}} frei</p>
    {{else}}
    <div class="ls-widget-value">–</div><p>Auf diesem System nicht messbar</p>
    {{end}}
  </div>
  <div class="ls-card ls-widget">
    <header>{{template "icon" "database"}}Speicherplatz</header>
    {{if .Sys.DiskOK}}
    <div class="ls-widget-value">{{.Sys.DiskUsedShort}} <small>von {{.Sys.DiskTotalShort}}</small></div>
    <meter min="0" max="100" value="{{.Sys.DiskPercent}}" low="75" high="90" optimum="0" aria-label="Speicherplatz belegt"></meter>
    <p>{{.Sys.DiskFreeShort}} frei</p>
    {{else}}
    <div class="ls-widget-value">–</div><p>Auf diesem System nicht messbar</p>
    {{end}}
  </div>
  <a class="ls-card ls-widget sc-widget-link" href="/backups">
    <header>{{template "icon" "archive"}}Sicherung</header>
    {{if .LastBackup}}
    <div class="ls-widget-value">{{.LastBackup}}</div>
    <p>{{.Backups}} {{if eq .Backups 1}}Sicherung{{else}}Sicherungen{{end}} auf dem Server</p>
    {{else}}
    <div class="ls-widget-value">Keine</div>
    <p>Noch nie gesichert</p>
    {{end}}
  </a>
  <a class="ls-card ls-widget sc-widget-link" href="/public">
    <header>{{template "icon" (or (and (eq .Mode "direct") "globe") "school")}}Zugang</header>
    {{if eq .Mode "direct"}}
    <div class="ls-widget-value">Internet</div>
    <p>Apps mit Adresse sind von überall erreichbar</p>
    {{else}}
    <div class="ls-widget-value">Schulnetz</div>
    <p>Alles bleibt im Schulnetz</p>
    {{end}}
  </a>
</section>

<div id="apps" data-view="grid">
  <div class="ls-bar">
    <h2>Apps</h2>
    {{if .HasApps}}
    <div class="ls-seg" data-ls-switch="#apps" role="group" aria-label="Darstellung">
      <button type="button" value="grid" aria-pressed="true">{{template "icon" "grid"}}Raster</button>
      <button type="button" value="list" aria-pressed="false">{{template "icon" "list"}}Liste</button>
    </div>
    {{end}}
  </div>

  {{if .HasApps}}
  <div class="ls-shelves">
    {{range .Shelves}}
    <section class="ls-shelf">
      <h3>{{.Title}} <span>{{len .Apps}}</span></h3>
      <div class="ls-launcher">
        {{range .Apps}}
        <button type="button" class="ls-app" data-ls-item="{{.Category}} {{.Description}}" data-ls-open="app-{{.ID}}">
          {{template "tile" .Tile}}
          <span class="ls-app-name">{{.Name}}</span>
          {{if not .Running}}<span class="ls-app-state" data-tone="bad">aus</span>{{end}}
          <span class="ls-sr">{{if .Running}}läuft{{else}}aus{{end}}{{if .UpdateTo}}, Update verfügbar{{end}}{{if eq .Where "internet"}}, auch im Internet{{end}}</span>
        </button>
        {{end}}
        {{if .Last}}
        <a class="ls-app" href="/apps"><span class="ls-tile" data-variant="add">{{template "dock-icon" "plus"}}</span><span class="ls-app-name">App holen</span></a>
        {{end}}
      </div>
    </section>
    {{end}}
  </div>

  <div class="ls-applist ls-list">
    {{range .Apps}}
    <button type="button" class="ls-row" data-ls-item="{{.Name}} {{.Category}} {{.Description}}" data-ls-open="app-{{.ID}}">
      {{template "tile" (tileSize .Tile "s")}}
      <span class="ls-row-label">{{.Name}}{{if .Description}}<small>{{.Description}}</small>{{end}}</span>
      <span class="ls-row-meta">{{categoryLabel .Category}}</span>
      <span class="ls-row-meta">{{.Version}}{{if .UpdateTo}} <span class="ls-pill" data-tone="warn" data-dot="no">{{.UpdateTo}}</span>{{end}}</span>
      {{template "where" .Where}}
      {{if .Running}}<span class="ls-pill" data-tone="ok">läuft</span>{{else}}<span class="ls-pill" data-tone="off">aus</span>{{end}}
    </button>
    {{end}}
  </div>

  <div class="ls-empty" data-ls-empty hidden>{{template "dock-icon" "search"}}<strong>Keine App gefunden.</strong><span>Vielleicht gibt es sie im <a href="/apps">Katalog</a>.</span></div>
  {{else}}
  <div class="ls-card ls-empty">
    {{template "dock-icon" "bag"}}
    <strong>Noch keine Apps installiert</strong>
    <span>Im Katalog findest du Apps für den Unterricht.</span>
    <a class="ls-btn" href="/apps">Zum Katalog</a>
  </div>
  {{end}}
</div>

{{if .Infra}}
<div class="ls-card ls-cluster sc-infra">
  {{if .InfraDown}}
  <strong class="ls-cluster sc-infra-state" data-tone="bad">{{template "icon" "alert"}}Grundversorgung: {{join .InfraDown ", "}} {{if eq (len .InfraDown) 1}}läuft{{else}}laufen{{end}} nicht</strong>
  {{else}}
  <strong class="ls-cluster sc-infra-state" data-tone="ok">{{template "icon" "check-circle"}}Grundversorgung läuft</strong>
  {{end}}
  {{range .Infra}}
  <button type="button" class="ls-chip" data-ls-open="app-{{.ID}}"{{if not .Running}} data-tone="bad"{{end}}>{{template "tile" .Tile}}{{.ShortName}}</button>
  {{end}}
</div>
{{end}}

{{if or .Internet .Updates .Alerts}}
<p class="ls-legend sc-legend">
  {{if .Internet}}<span><span class="ls-badge" data-kind="internet">{{template "dock-icon" "globe"}}</span>auch im Internet</span>{{end}}
  {{if .Updates}}<span><span class="ls-badge" data-kind="update">{{template "dock-icon" "update"}}</span>Update da</span>{{end}}
  {{if .Alerts}}<span><span class="ls-badge" data-kind="alert">{{template "dock-icon" "alert"}}</span>braucht dich</span>{{end}}
</p>
{{end}}

{{range .Sheets}}{{template "app-sheet" (sheetCtx . $.CSRFToken $.Mode)}}{{end}}

{{template "shell-end" .PageData}}
{{template "foot" .}}
{{end}}

{{define "where"}}{{if eq . "internet"}}<span class="ls-where" data-where="internet">{{template "dock-icon" "globe"}}Internet</span>{{else}}<span class="ls-where" data-where="school">{{template "dock-icon" "school"}}Schulnetz</span>{{end}}{{end}}

{{/* Blatt einer installierten App. Erwartet sheetCtx: .App, .CSRFToken, .Mode */}}
{{define "app-sheet"}}
{{$a := .App}}{{$csrf := .CSRFToken}}
<dialog class="ls-sheet" id="app-{{$a.ID}}" aria-labelledby="app-{{$a.ID}}-title">
  <form method="dialog" class="ls-sheet-bar"><button class="ls-iconbtn" aria-label="Schließen">{{template "icon" "x"}}</button></form>
  <div class="ls-sheet-hero">
    {{template "tile" (tileSize $a.Tile "")}}
    <h2 id="app-{{$a.ID}}-title">{{$a.Name}}</h2>
    {{if $a.Description}}<p>{{$a.Description}}</p>{{end}}
    {{if $a.Running}}<span class="ls-pill" data-tone="ok">läuft</span>{{else}}<span class="ls-pill" data-tone="bad">aus</span>{{end}}
    <div class="ls-actions">
      {{if and $a.OpenURL $a.Running}}<a class="ls-btn" href="{{$a.OpenURL}}" target="_blank" rel="noopener">{{template "icon" "external"}}Öffnen</a>{{end}}
      {{if $a.UpdateTo}}
      <form method="post" action="/apps/{{$a.ID}}/update">{{csrfField $csrf}}<button type="submit" data-variant="{{if $a.OpenURL}}ghost{{end}}" data-busy>{{template "icon" "update"}}Auf {{$a.UpdateTo}} aktualisieren</button></form>
      {{end}}
      {{if $a.Running}}
      <form method="post" action="/apps/{{$a.ID}}/stop">{{csrfField $csrf}}<button type="submit" data-variant="ghost" data-busy>{{template "icon" "power"}}Ausschalten</button></form>
      {{else}}
      <form method="post" action="/apps/{{$a.ID}}/start">{{csrfField $csrf}}<button type="submit" data-busy>{{template "icon" "power"}}Einschalten</button></form>
      {{end}}
    </div>
  </div>

  {{if $a.IsMandatory}}
  <p class="sc-sheet-note">{{template "icon" "info"}}<span>{{$a.Name}} gehört zur Grundversorgung. Ausgeschaltet funktionieren andere Apps nicht mehr.</span></p>
  {{end}}

  {{if or $a.CanPublish $a.PublicEnabled}}
  <span class="ls-list-label">Adresse</span>
  <div class="ls-list">
    {{if $a.PublicEnabled}}
    <a class="ls-row" href="https://{{$a.PublicHost}}" target="_blank" rel="noopener"><span class="ls-row-label">{{$a.PublicHost}}<small>{{if eq .Mode "direct"}}Von überall erreichbar, für alle mit Schulkonto.{{else}}Im Schulnetz, für alle mit Schulkonto.{{end}}</small></span>{{template "where" $a.Where}}</a>
    {{else}}
    <div class="ls-row"><span class="ls-row-label">Keine Adresse<small>Erreichbar nur über {{$a.ServerDomain}}:{{$a.Port}}{{if $a.HasOIDC}}. Die Anmeldung mit Schulkonto braucht eine Adresse.{{end}}</small></span></div>
    {{end}}
    <form method="post" action="/apps/{{$a.ID}}/public/{{if $a.PublicEnabled}}disable{{else}}enable{{end}}" class="ls-row sc-row-form">
      {{csrfField $csrf}}
      <span class="ls-row-label">Adresse {{if $a.PublicEnabled}}abschalten{{else}}einschalten{{end}}{{if and $a.PublicEnabled $a.HasOIDC}}<small>Danach funktioniert die Anmeldung in der App nicht mehr.</small>{{end}}</span>
      <button type="submit" data-size="s" data-variant="{{if $a.PublicEnabled}}ghost{{end}}" data-busy>{{if $a.PublicEnabled}}Abschalten{{else}}Einschalten{{end}}</button>
    </form>
  </div>
  {{end}}

  <span class="ls-list-label">Updates</span>
  <div class="ls-list">
    <div class="ls-row"><span class="ls-row-label">Version</span><span class="ls-row-value">{{$a.Version}}{{if $a.UpdateTo}} → {{$a.UpdateTo}}{{end}}</span></div>
    <form method="post" action="/apps/{{$a.ID}}/autoupdate" class="ls-row sc-row-form" data-autosubmit>
      {{csrfField $csrf}}
      <label class="sc-switch-row"><span class="ls-row-label">Automatisch aktualisieren<small>Nachts, wenn es in den Einstellungen eingeschaltet ist. Größere Updates nie automatisch.</small></span>
      <input type="checkbox" role="switch" name="auto"{{if $a.AutoUpdate}} checked{{end}}></label>
      <noscript><button type="submit" data-size="s" data-variant="ghost">Speichern</button></noscript>
    </form>
  </div>
  {{if $a.UpdateBreaking}}<p class="ls-list-hint">Das Update auf {{$a.UpdateTo}} ist größer, zum Beispiel mit Umbau der Datenbank. Vorher eine <a href="/backups">Sicherung</a> anlegen.</p>{{end}}

  {{if $a.HasOIDC}}
  <span class="ls-list-label">Anmeldung mit Schulkonto</span>
  <div class="ls-list">
    <div class="ls-row"><span class="ls-row-label">Client-ID<small><code>{{$a.OIDCClientID}}</code></small></span>{{template "copy-btn" $a.OIDCClientID}}</div>
    <div class="ls-row"><span class="ls-row-label">Weiterleitung<small class="sc-break"><code>{{$a.OIDCRedirectURI}}</code></small></span>{{template "copy-btn" $a.OIDCRedirectURI}}</div>
  </div>
  {{end}}

  {{if or $a.AdminLogin $a.AdminPassword $a.AdminNotes}}
  <span class="ls-list-label">Verwaltung der App</span>
  <div class="ls-list">
    {{if $a.AdminLogin}}<div class="ls-row"><span class="ls-row-label">Benutzer<small><code>{{$a.AdminLogin}}</code></small></span>{{template "copy-btn" $a.AdminLogin}}</div>{{end}}
    {{if $a.AdminPassword}}<div class="ls-row"><span class="ls-row-label">Passwort<small>{{$a.AdminPassword}}</small></span></div>{{end}}
  </div>
  {{if $a.AdminNotes}}<p class="ls-list-hint sc-pre">{{$a.AdminNotes}}</p>{{end}}
  {{end}}

  <span class="ls-list-label">Für Fortgeschrittene</span>
  <div class="ls-list">
    <details><summary class="ls-row"><span class="ls-row-label">Technische Angaben</span></summary>
      <dl class="sc-tech">
        <dt>Container</dt><dd><code>{{$a.ContainerName}}</code></dd>
        {{if $a.Port}}<dt>Port</dt><dd><code>{{$a.Port}}</code></dd>{{end}}
        <dt>Daten</dt><dd><code>{{$a.DataDir}}</code></dd>
        {{if $a.InstalledAt}}<dt>Installiert</dt><dd>{{$a.InstalledAt}}</dd>{{end}}
      </dl>
    </details>
    {{if $a.Homepage}}<a class="ls-row" href="{{$a.Homepage}}" target="_blank" rel="noopener"><span class="ls-row-label">Webseite der App</span>{{template "icon" "external"}}</a>{{end}}
    {{if $a.Docs}}<a class="ls-row" href="{{$a.Docs}}" target="_blank" rel="noopener"><span class="ls-row-label">Anleitung</span>{{template "icon" "external"}}</a>{{end}}
  </div>

  <div class="ls-list sc-danger-zone"><button type="button" class="ls-row" data-tone="danger" data-ls-open="remove-{{$a.ID}}"><span class="ls-row-label">{{$a.Name}} entfernen …</span></button></div>
</dialog>

<dialog class="ls-dialog" id="remove-{{$a.ID}}" aria-labelledby="remove-{{$a.ID}}-title">
  <form method="post" action="/apps/{{$a.ID}}/remove">
    {{csrfField $csrf}}
    <h2 id="remove-{{$a.ID}}-title">{{$a.Name}} entfernen?</h2>
    {{if $a.IsMandatory}}<p class="sc-warn">{{$a.Name}} gehört zur Grundversorgung. Ohne ihn funktionieren andere Apps nicht mehr.</p>{{end}}
    <p>Die App verschwindet für alle. Ihre Daten bleiben auf dem Server und werden bei einer neuen Installation wieder benutzt.</p>
    <label class="sc-check"><input type="checkbox" name="wipe_data"><span>Auch die Daten löschen<small>Datenbank und <code>{{$a.DataDir}}</code>. Das lässt sich nicht rückgängig machen.</small></span></label>
    <div class="ls-actions">
      <button type="button" data-variant="ghost" data-close>Abbrechen</button>
      <button type="submit" data-variant="danger" data-busy>Entfernen</button>
    </div>
  </form>
</dialog>
{{end}}

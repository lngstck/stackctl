{{define "page"}}
{{template "head" .}}
{{template "sidebar-layout-start" .PageData}}

<h2 class="mb-2">{{.Result.AppName}} – Installation</h2>

{{if .Result.Success}}
<div role="alert" data-variant="success" class="mb-2">
  <strong>{{.Result.AppName}}</strong> wurde erfolgreich installiert.
</div>
{{else}}
<div role="alert" data-variant="danger" class="mb-2">
  Installation fehlgeschlagen: {{.Result.Error}}
</div>
{{end}}

{{if .Result.Messages}}
<article class="card mb-2">
  <h4 class="mb-1">Hinweise</h4>
  <ul>
    {{range .Result.Messages}}
    <li>{{.}}</li>
    {{end}}
  </ul>
</article>
{{end}}

{{if .Result.SecretsToShow}}
<article class="card mb-2">
  <h4 class="mb-1">Generierte Secrets</h4>
  <p class="sub mb-1" style="font-size:0.85rem;">
    Diese Werte werden nur einmal angezeigt. Bitte jetzt kopieren und sicher aufbewahren.
  </p>
  <table>
    <tbody>
      {{range $key, $val := .Result.SecretsToShow}}
      <tr>
        <td class="sub">{{$key}}</td>
        <td>
          <code style="word-break:break-all;">{{$val}}</code>
          <button class="ghost small" style="margin-left:0.5rem;font-size:0.75rem;"
                  onclick="navigator.clipboard.writeText('{{$val}}');this.textContent='Kopiert ✓';setTimeout(()=>this.textContent='Kopieren',2000)">
            Kopieren
          </button>
        </td>
      </tr>
      {{end}}
    </tbody>
  </table>
</article>
{{end}}

<div style="display:flex;gap:0.5rem;">
  <a href="/apps/{{.Result.AppID}}" class="button">App-Details</a>
  <a href="/apps" class="button ghost">Zurueck zum Katalog</a>
</div>

{{template "sidebar-layout-end" .PageData}}
{{template "foot" .}}
{{end}}

{{define "title"}}Einrichtung{{end}}
{{define "page"}}
{{template "head" .}}
<body class="sc-bare">
<main class="sc-bare-main sc-setup" id="inhalt">
  <a class="ls-wordmark sc-bare-mark" href="/setup"><svg class="ls-mark" aria-hidden="true"><use href="/static/ls/icons/icons.svg#mark"/></svg>learningstack</a>

  <div class="ls-hello">
    <h1>Einrichtung</h1>
    <p>Einmal ausfüllen, dann läuft learningstack an deiner Schule.</p>
  </div>

  {{if .Error}}<p class="sc-flash" data-tone="bad" role="alert">{{template "icon" "alert"}}<span>{{.Error}}</span></p>{{end}}

  <form method="post" action="/setup" class="sc-setup-form">
    <span class="ls-list-label">Einrichtungscode</span>
    <div class="ls-list">
      <div class="ls-field">
        <label for="setup-code">Code aus dem Terminal</label>
        <input type="text" name="setup_code" value="{{.SetupCode}}" required autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX" id="setup-code">
        <span class="ls-field-hint">Steht am Ende der Installation, im Link schon eingetragen. Neu anzeigen: <code>sudo stackctl setup-code</code></span>
      </div>
    </div>

    <span class="ls-list-label">Schule</span>
    <div class="ls-list">
      <div class="ls-field"><label for="school-name">Schulname</label><input type="text" name="school_name" value="{{.SchoolName}}" placeholder="Gymnasium Musterstadt" required id="school-name"></div>
      <div class="ls-field"><label for="slug-input">Kennung</label>
        <div class="sc-suffix"><input type="text" name="school_slug" value="{{.SchoolSlug}}" placeholder="aus dem Schulnamen" id="slug-input" autocapitalize="none" spellcheck="false"><button type="button" data-size="s" data-variant="ghost" id="derive-slug-btn">Ableiten</button></div>
        <span class="ls-field-hint">Kurzform der Schule: a–z, 0–9, Bindestrich, höchstens 30 Zeichen. Apps nutzen sie intern.</span></div>
      <div class="ls-field"><label for="server-ip">Adresse dieses Servers im Schulnetz</label><input type="text" name="server_domain" value="{{.ServerDomain}}" placeholder="wird erkannt" id="server-ip" inputmode="decimal"><span class="ls-field-hint">Automatisch erkannt. Darauf zeigen Login und Apps.</span></div>
      <div class="ls-field"><label for="contact-email">E-Mail für Rückfragen</label><input type="email" name="contact_email" value="{{.ContactEmail}}" placeholder="it@schule.de" id="contact-email"><span class="ls-field-hint">Dorthin gehen Warnungen zu den Zertifikaten.</span></div>
    </div>

    <span class="ls-list-label">Wo sollen Login und Apps erreichbar sein?</span>
    <div class="ls-list">
      <label class="ls-row sc-mode"><input type="radio" name="public_mode" value="local"{{if ne .Mode "direct"}} checked{{end}}>
        <span class="ls-row-label">Nur im Schulnetz <span class="ls-pill" data-tone="ok" data-dot="no">empfohlen</span><small>Mit echtem Zertifikat. Von außen kommt niemand heran, keine Schülerdaten verlassen das Schulnetz. Vorzubereiten: ein kostenloses Konto bei deSEC und zwei Einträge beim DNS-Anbieter der Schule.</small></span>
        {{template "icon" "school"}}</label>
    </div>
    <details class="ls-list sc-gap-s"{{if eq .Mode "direct"}} open{{end}}>
      <summary class="ls-row"><span class="ls-row-label">Erweitert: Server direkt am Internet</span></summary>
      <label class="ls-row sc-mode"><input type="radio" name="public_mode" value="direct"{{if eq .Mode "direct"}} checked{{end}}>
        <span class="ls-row-label">Direkter Betrieb <span class="ls-pill" data-tone="warn" data-dot="no">Ports 80/443 offen</span><small>Der Server hängt selbst am Internet und holt seine Zertifikate bei Let's Encrypt. Login und Apps sind dann aus dem Internet erreichbar.</small></span>
        {{template "icon" "globe"}}</label>
    </details>
    <p class="ls-list-hint">Lässt sich später nur mit Aufwand ändern: Die Adresse steckt in jedem Login.</p>

    <span class="ls-list-label">Domain</span>
    <div class="ls-list">
      <div class="ls-field"><label for="base-domain">Domain der Schule</label><input type="text" name="base_domain" value="{{.BaseDomain}}" placeholder="apps.gymnasium-musterstadt.de" id="base-domain" autocapitalize="none" spellcheck="false">
        <span class="ls-field-hint">Ohne <code>*.</code> und ohne <code>https://</code>. Darunter liegen Login und Apps, etwa <code id="domain-preview">auth.deine-domain.de, pylearn.deine-domain.de</code></span></div>
    </div>

    <div id="local-fields">
      <span class="ls-list-label">Zertifikat über deSEC</span>
      <div class="ls-list">
        <div class="ls-row sc-step-row"><span class="sc-num">1</span><span class="ls-row-label">Bei <a href="https://desec.io" target="_blank" rel="noopener">desec.io</a> ein Konto anlegen und dort die Domain <code class="js-domain">deine-domain.de</code> hinzufügen.<small>deSEC ist kostenlos und gemeinnützig.</small></span></div>
        <div class="ls-row sc-step-row" id="ns-step"><span class="sc-num">2</span><span class="ls-row-label">Beim DNS-Anbieter der Schuldomain diese Einträge anlegen:<pre class="sc-records" id="dns-records"></pre></span></div>
        <div class="ls-row sc-step-row"><span class="sc-num">3</span><span class="ls-row-label">Bei deSEC einen Token erzeugen und hier eintragen.</span></div>
        <div class="ls-field"><label for="dns-token">deSEC-Token</label><input type="password" name="dns_token" value="{{.DNSToken}}" autocomplete="off" id="dns-token">
          <span class="ls-field-hint" id="wildcard-hint">Den Eintrag <code>*.<span class="js-domain">deine-domain.de</span></code> auf diesen Server legt stackctl damit selbst bei deSEC an.</span></div>
      </div>
      <details class="ls-list sc-gap-s"{{if .ChallengeDomain}} open{{end}}>
        <summary class="ls-row"><span class="ls-row-label">Der DNS-Anbieter erlaubt keine NS-Einträge?</span></summary>
        <div class="ls-field"><label for="challenge-domain">Ziel bei deSEC</label><input type="text" name="challenge_domain" value="{{.ChallengeDomain}}" placeholder="_acme-challenge.schule.example" id="challenge-domain" autocapitalize="none" spellcheck="false">
          <span class="ls-field-hint">Dann bleibt die Domain beim Anbieter, nur die Zertifikatsprüfung geht per CNAME zu deSEC. Den Eintrag <code>*.</code> legst du dann selbst beim Anbieter an. Im Normalfall leer.</span></div>
      </details>
    </div>

    <div id="direct-fields">
      <span class="ls-list-label">Zertifikat über Let's Encrypt</span>
      <div class="ls-list">
        <div class="ls-field"><label for="acme-email">E-Mail für Zertifikats-Warnungen</label><input type="email" name="acme_email" value="{{.ACMEEmail}}" placeholder="wie oben" id="acme-email"><span class="ls-field-hint">Let's Encrypt meldet sich dort, wenn eine Erneuerung länger scheitert. Leer heißt: die E-Mail von oben.</span></div>
      </div>
    </div>

    <div class="sc-check-bar">
      <button type="button" data-variant="ghost" id="check-btn">{{template "icon" "check-circle"}}Voraussetzungen prüfen</button>
      <span id="check-hint" class="sc-check-hint"></span>
    </div>
    <div id="check-result" class="ls-list" hidden></div>

    <span class="ls-list-label">Admin-Passwort</span>
    <div class="ls-list">
      <div class="ls-field"><label for="password-input">Passwort für diese Verwaltung</label><input type="password" name="password" minlength="8" required id="password-input" autocomplete="new-password"></div>
      <div class="ls-field"><label for="password-confirm">Noch einmal</label><input type="password" name="password_confirm" minlength="8" required id="password-confirm" autocomplete="new-password"></div>
      <div class="ls-field">
        <div class="ls-actions">
          <button type="button" data-size="s" data-variant="ghost" id="gen-password-btn">Erzeugen</button>
          <button type="button" data-size="s" data-variant="ghost" id="copy-password-btn" hidden>Kopieren</button>
          <button type="button" data-size="s" data-variant="ghost" id="show-password-btn" hidden>Anzeigen</button>
        </div>
        <span class="ls-field-hint" id="password-hint" hidden></span>
      </div>
    </div>

    <button type="submit" data-size="l" class="sc-setup-submit" data-busy>Einrichtung abschließen</button>
  </form>
</main>

<script>
(function() {
  // --- Kennung aus dem Schulnamen ---
  const nameInput = document.getElementById('school-name');
  const slugInput = document.getElementById('slug-input');
  document.getElementById('derive-slug-btn').addEventListener('click', function() {
    const name = nameInput.value.trim();
    if (!name) { nameInput.focus(); return; }
    slugInput.value = deriveSlug(name);
  });

  function deriveSlug(name) {
    name = name.toLowerCase();
    const map = {'ä':'ae','ö':'oe','ü':'ue','ß':'ss'};
    name = name.replace(/[äöüß]/g, c => map[c] || c);
    const words = name.split(/[\s\-_.,]+/)
      .map(w => w.replace(/[^a-z0-9]/g, ''))
      .filter(w => w.length > 0);
    // Allgemeine Schulform-Wörter tragen nichts zur Kennung bei.
    const skip = new Set([
      'schule','grundschule','oberschule','realschule','hauptschule',
      'gesamtschule','gymnasium','igs','bbs','fos','kgs','ganztagsschule',
      'der','die','das','und','von','zu','am','an','im','in','fuer','for'
    ]);
    let meaningful = words.filter(w => !skip.has(w));
    if (meaningful.length === 0) meaningful = words.slice(0, 1);
    let slug = '';
    for (const w of meaningful) {
      const next = slug ? slug + '-' + w : w;
      if (next.length > 30) break;
      slug = next;
    }
    if (!slug && meaningful.length > 0) slug = meaningful[0].substring(0, 30);
    return slug.replace(/-{2,}/g, '-').replace(/^-|-$/g, '');
  }

  // --- Betriebsart: nur die Felder zeigen, die sie braucht ---
  const modeInputs = document.querySelectorAll('input[name="public_mode"]');
  const baseDomain = document.getElementById('base-domain');
  const serverIP = document.getElementById('server-ip');
  const dnsToken = document.getElementById('dns-token');
  const challengeDomain = document.getElementById('challenge-domain');
  const domainPreview = document.getElementById('domain-preview');
  const dnsRecords = document.getElementById('dns-records');
  const localFields = document.getElementById('local-fields');
  const directFields = document.getElementById('direct-fields');
  const checkResult = document.getElementById('check-result');
  const checkHint = document.getElementById('check-hint');

  function currentMode() {
    for (const el of modeInputs) if (el.checked) return el.value;
    return '';
  }

  function syncMode() {
    const mode = currentMode();
    localFields.hidden = (mode !== 'local');
    directFields.hidden = (mode !== 'direct');
    // Ergebnisse gelten nur für die Betriebsart, für die sie entstanden.
    checkResult.replaceChildren(); checkResult.hidden = true;
    checkHint.textContent = '';
  }

  // Die Einträge, die die Admin anlegen muss, während sie tippt. Normal
  // geht die Domain mit zwei NS-Einträgen an deSEC und stackctl setzt den
  // Wildcard selbst; mit Ziel bei deSEC behält die Schule ihre Zone und legt
  // Wildcard und CNAME für die Prüfung selbst an.
  function syncPreview() {
    const domain = baseDomain.value.trim().toLowerCase() || 'deine-domain.de';
    domainPreview.textContent = 'auth.' + domain + ', pylearn.' + domain;
    document.querySelectorAll('.js-domain').forEach(el => { el.textContent = domain; });
    const target = challengeDomain.value.trim().toLowerCase().replace(/\.$/, '');
    let records;
    if (target) {
      records = '*.' + domain + '   A       ' + (serverIP.value.trim() || '<Server-IP>') +
        '\n_acme-challenge.' + domain + '   CNAME   ' + target + '.';
    } else {
      records = domain + '   NS   ns1.desec.io.\n' + domain + '   NS   ns2.desec.org.';
    }
    dnsRecords.textContent = records;
    document.getElementById('wildcard-hint').hidden = !!target;
  }

  modeInputs.forEach(el => el.addEventListener('change', syncMode));
  [baseDomain, serverIP, challengeDomain].forEach(el => el.addEventListener('input', syncPreview));
  syncMode();
  syncPreview();

  // --- Voraussetzungen prüfen ---
  const checkBtn = document.getElementById('check-btn');
  const TONE = { ok: 'ok', warn: 'warn', fail: 'bad', skip: 'off' };
  const WORD = { ok: 'in Ordnung', warn: 'Hinweis', fail: 'fehlt', skip: 'später' };

  function row(c) {
    const r = document.createElement('div');
    r.className = 'ls-row';
    const l = document.createElement('span');
    l.className = 'ls-row-label';
    l.textContent = c.title;
    const d = document.createElement('small');
    d.textContent = c.detail;
    l.appendChild(d);
    const p = document.createElement('span');
    p.className = 'ls-pill'; p.dataset.tone = TONE[c.status] || 'off'; p.textContent = WORD[c.status] || c.status;
    r.append(l, p);
    return r;
  }

  checkBtn.addEventListener('click', function() {
    const domain = baseDomain.value.trim().toLowerCase();
    if (!domain) { baseDomain.focus(); return; }
    checkBtn.setAttribute('aria-busy', 'true'); checkBtn.disabled = true;
    checkHint.textContent = '';
    checkResult.replaceChildren(); checkResult.hidden = true;

    // POST, nicht GET: Der Token gehört in keine URL und kein Server-Log.
    const params = new URLSearchParams({
      setup_code: document.getElementById('setup-code').value,
      mode: currentMode(),
      base_domain: domain,
      dns_token: dnsToken.value.trim(),
      challenge_domain: challengeDomain.value.trim().toLowerCase(),
    });
    fetch('/setup/preflight', { method: 'POST', body: params })
      .then(resp => {
        if (resp.status === 403) throw new Error('setup-code');
        return resp.json();
      })
      .then(data => {
        checkResult.replaceChildren(...(data.checks || []).map(row));
        checkResult.hidden = false;
        // Fehlende Einträge blockieren die Einrichtung nicht: DNS braucht
        // seine Zeit, und wer den Server zuerst vorbereitet, macht nichts
        // falsch.
        if (data.summary === 'ok') checkHint.textContent = 'Alles bereit.';
        else if (data.summary === 'fail') checkHint.textContent = 'Noch nicht vollständig. Abschließen geht trotzdem.';
        else checkHint.textContent = 'Mit Einschränkungen bereit.';
      })
      .catch(err => {
        checkHint.textContent = err.message === 'setup-code'
          ? 'Erst den Einrichtungscode oben eintragen.'
          : 'Prüfung fehlgeschlagen.';
      })
      .finally(() => { checkBtn.removeAttribute('aria-busy'); checkBtn.disabled = false; });
  });

  // --- Passwort erzeugen ---
  const genBtn = document.getElementById('gen-password-btn');
  const copyBtn = document.getElementById('copy-password-btn');
  const showBtn = document.getElementById('show-password-btn');
  const pwInput = document.getElementById('password-input');
  const pwConfirm = document.getElementById('password-confirm');
  const pwHint = document.getElementById('password-hint');
  let generatedPW = '';

  genBtn.addEventListener('click', function() {
    generatedPW = generatePassword(20);
    pwInput.type = 'password';
    pwConfirm.type = 'password';
    pwInput.value = generatedPW;
    pwConfirm.value = generatedPW;
    copyBtn.hidden = false;
    showBtn.hidden = false;
    showBtn.textContent = 'Anzeigen';
    pwHint.textContent = 'Erzeugt. Bitte kopieren und sicher aufbewahren.';
    pwHint.hidden = false;
  });

  copyBtn.addEventListener('click', function() {
    window.stackctlCopy(generatedPW).then(function() {
      copyBtn.textContent = 'Kopiert';
      setTimeout(function() { copyBtn.textContent = 'Kopieren'; }, 2000);
    });
  });

  showBtn.addEventListener('click', function() {
    const showing = pwInput.type === 'text';
    pwInput.type = showing ? 'password' : 'text';
    pwConfirm.type = showing ? 'password' : 'text';
    showBtn.textContent = showing ? 'Anzeigen' : 'Verbergen';
  });

  function generatePassword(len) {
    const chars = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ23456789!@#$%&*+-=?';
    const arr = new Uint8Array(len);
    crypto.getRandomValues(arr);
    let pw = '';
    for (let i = 0; i < len; i++) pw += chars[arr[i] % chars.length];
    return pw;
  }
})();
</script>
{{template "foot" .}}
{{end}}

{{define "page"}}
{{template "head" .}}

<div class="centered-box centered-box--wide">
  <h1 class="mb-2" style="text-align:center;">
    <span class="wordmark wordmark--lg">
      <span class="wordmark__mark"></span>
      <span class="wordmark__name">learningstack</span>
      <span class="wordmark__app">stackctl</span>
    </span>
  </h1>
  <p class="sub mb-3" style="text-align:center;">Ersteinrichtung – bitte alle Felder ausfuellen.</p>

  {{if .Error}}
  <div role="alert" data-variant="danger" class="mb-2">{{.Error}}</div>
  {{end}}

  <article class="card">
    <form method="post" action="/setup">
      <label data-field class="mb-2">
        Einrichtungscode
        <input type="text" name="setup_code" value="{{.SetupCode}}" required autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="XXXX-XXXX" id="setup-code">
        <span class="hint">Steht im Terminal am Ende der Installation, im Link schon eingetragen. Neu anzeigen: <code>sudo stackctl setup-code</code></span>
      </label>

      <h3 class="mb-2">Schule</h3>

      <label data-field class="mb-1">
        Schulname
        <input type="text" name="school_name" value="{{.SchoolName}}" placeholder="z.B. Gymnasium Musterstadt" required id="school-name">
      </label>

      <label data-field class="mb-1">
        Schul-Slug
        <div style="display:flex;gap:0.5rem;align-items:center;">
          <input type="text" name="school_slug" value="{{.SchoolSlug}}" placeholder="aus Schulname ableiten" id="slug-input" style="flex:1;">
          <button type="button" class="ghost small" id="derive-slug-btn" title="Slug aus Schulname ableiten">Ableiten</button>
        </div>
        <span class="hint">Kurzform der Schule (a-z, 0-9, Bindestrich, max. 30 Zeichen). Apps nutzen sie als interne Kennung der Schule.</span>
      </label>

      <label data-field class="mb-1">
        Server-IP / Hostname
        <input type="text" name="server_domain" value="{{.ServerDomain}}" placeholder="wird automatisch erkannt" id="server-ip">
        <span class="hint">Automatisch erkannt. LAN-Adresse dieses Servers.</span>
      </label>

      <label data-field class="mb-2">
        Kontakt-E-Mail
        <input type="email" name="contact_email" value="{{.ContactEmail}}" placeholder="admin@schule.de">
        <span class="hint">Standard-Adresse für Warnungen zu den Zertifikaten.</span>
      </label>

      <h3 class="mb-1">Betriebsart</h3>
      <p class="sub mb-2" style="font-size:0.85rem;">
        Wo sollen Login und Apps erreichbar sein? Das laesst sich spaeter nur
        mit Aufwand aendern — die Adresse steckt in jedem Login.
      </p>

      <div class="mode-choice mb-2">
        <label class="mode-card">
          <div class="mode-card__top">
            <input type="radio" name="public_mode" value="local" {{if ne .Mode "direct"}}checked{{end}}>
            <span class="mode-card__title">Nur im Schulnetz</span>
            <span class="mode-card__tag">empfohlen</span>
          </div>
          <div class="mode-card__body">
            Login und Apps sind im Schulnetz erreichbar, mit echtem Zertifikat.
            Von aussen kommt niemand heran, keine Schuelerdaten verlassen das
            Schulnetz. Vorzubereiten: zwei DNS-Eintraege und ein kostenloses
            Konto bei deSEC fuer das Zertifikat.
          </div>
        </label>
      </div>

      <details class="mb-2" {{if eq .Mode "direct"}}open{{end}}>
        <summary class="sub" style="font-size:0.85rem;cursor:pointer;">Erweitert: Server direkt am Internet</summary>
        <div class="mode-choice mt-1">
          <label class="mode-card">
            <div class="mode-card__top">
              <input type="radio" name="public_mode" value="direct" {{if eq .Mode "direct"}}checked{{end}}>
              <span class="mode-card__title">Direkter Betrieb</span>
              <span class="mode-card__tag">Ports 80/443 offen</span>
            </div>
            <div class="mode-card__body">
              Der Server haengt selbst am Internet und holt seine Zertifikate
              ueber Let's Encrypt. Dafuer muss der Wildcard-Eintrag auf seine
              oeffentliche Adresse zeigen und Port 80 und 443 muessen von
              aussen erreichbar sein. Login und Apps sind dann aus dem
              Internet erreichbar.
            </div>
          </label>
        </div>
      </details>

      <label data-field class="mb-1">
        Domain der Schule
        <input type="text" name="base_domain" value="{{.BaseDomain}}" placeholder="z.B. apps.gymnasium-musterstadt.de" id="base-domain">
        <span class="hint">
          Ohne <code>*.</code> und ohne <code>https://</code>. Darunter liegen
          Login und Apps: <code id="domain-preview">auth.deine-domain.de, pylearn.deine-domain.de</code>
        </span>
      </label>

      <div id="local-fields">
        <label data-field class="mb-1">
          deSEC-Token
          <input type="password" name="dns_token" value="{{.DNSToken}}" autocomplete="off" id="dns-token">
          <span class="hint">
            Fuer das Zertifikat. Bei <a href="https://desec.io" target="_blank" rel="noopener">desec.io</a>
            ein kostenloses Konto anlegen, dort eine Domain wie
            <code>meine-schule.dedyn.io</code> registrieren und einen Token erzeugen.
          </span>
        </label>

        <label data-field class="mb-1">
          Ziel bei deSEC
          <input type="text" name="challenge_domain" value="{{.ChallengeDomain}}" placeholder="z.B. _acme-challenge.meine-schule.dedyn.io" id="challenge-domain">
          <span class="hint">Leer lassen, wenn deSEC die Domain der Schule selbst verwaltet.</span>
        </label>

        <p class="sub mb-1" style="font-size:0.85rem;">Beim DNS-Anbieter der Schuldomain anlegen:</p>
        <pre class="mb-2" id="dns-records" style="background:var(--faint);padding:0.75rem 1rem;border-radius:0.5rem;font-size:0.8rem;overflow-x:auto;"></pre>
      </div>

      <div id="direct-fields">
        <label data-field class="mb-1">
          E-Mail fuer Zertifikats-Warnungen
          <input type="email" name="acme_email" value="{{.ACMEEmail}}" placeholder="wie Kontakt-E-Mail" id="acme-email">
          <span class="hint">Let's Encrypt meldet hierhin, wenn eine Erneuerung laengere Zeit scheitert. Leer = Kontakt-E-Mail von oben.</span>
        </label>
      </div>

      <div class="mb-2" style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
        <button type="button" class="ghost small" id="check-btn">Voraussetzungen pruefen</button>
        <span class="sub" style="font-size:0.8rem;" id="check-hint"></span>
      </div>
      <div id="check-result" class="mb-2"></div>

      <h3 class="mb-2">Admin-Zugang</h3>

      <label data-field class="mb-1">
        Admin-Passwort
        <input type="password" name="password" minlength="8" required id="password-input">
      </label>

      <label data-field class="mb-1">
        Passwort wiederholen
        <input type="password" name="password_confirm" minlength="8" required id="password-confirm">
      </label>

      <div class="mb-2" style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap;">
        <button type="button" class="ghost small" id="gen-password-btn">Generieren</button>
        <button type="button" class="ghost small" id="copy-password-btn" style="display:none;">Kopieren</button>
        <button type="button" class="ghost small" id="show-password-btn" style="display:none;">Anzeigen</button>
        <span class="sub" style="font-size:0.8rem;display:none;" id="password-hint"></span>
      </div>

      <button type="submit" class="mt-2" style="width:100%;">Setup abschliessen</button>
    </form>
  </article>
</div>

<script>
(function() {
  // --- Slug derivation ---
  const nameInput = document.getElementById('school-name');
  const slugInput = document.getElementById('slug-input');
  const deriveBtn = document.getElementById('derive-slug-btn');

  deriveBtn.addEventListener('click', function() {
    const name = nameInput.value.trim();
    if (!name) { slugInput.focus(); return; }
    slugInput.value = deriveSlug(name);
  });

  function deriveSlug(name) {
    // Lowercase + umlaut replacement.
    name = name.toLowerCase();
    const map = {'ä':'ae','ö':'oe','ü':'ue','ß':'ss'};
    name = name.replace(/[äöüß]/g, c => map[c] || c);

    // Split into words, keep only a-z0-9.
    const words = name.split(/[\s\-_.,]+/)
      .map(w => w.replace(/[^a-z0-9]/g, ''))
      .filter(w => w.length > 0);

    // Drop generic school-type words.
    const skip = new Set([
      'schule','grundschule','oberschule','realschule','hauptschule',
      'gesamtschule','gymnasium','igs','bbs','fos','kgs','ganztagsschule',
      'der','die','das','und','von','zu','am','an','im','in','fuer','for'
    ]);
    let meaningful = words.filter(w => !skip.has(w));

    // Fallback: if everything was filtered, use first non-generic word.
    if (meaningful.length === 0) meaningful = words.slice(0, 1);

    // Join with dashes, truncate to 10 chars at word boundary.
    let slug = '';
    for (const w of meaningful) {
      const next = slug ? slug + '-' + w : w;
      if (next.length > 30) break;
      slug = next;
    }

    // If first word alone is >10, hard-truncate.
    if (!slug && meaningful.length > 0) {
      slug = meaningful[0].substring(0, 30);
    }

    return slug.replace(/-{2,}/g, '-').replace(/^-|-$/g, '');
  }

  // --- Operating mode: show only the fields that mode needs ---
  const modeInputs = document.querySelectorAll('input[name="public_mode"]');
  const baseDomain = document.getElementById('base-domain');
  const serverIP = document.getElementById('server-ip');
  const dnsToken = document.getElementById('dns-token');
  const challengeDomain = document.getElementById('challenge-domain');
  const domainPreview = document.getElementById('domain-preview');
  const dnsRecords = document.getElementById('dns-records');
  const localFields = document.getElementById('local-fields');
  const directFields = document.getElementById('direct-fields');
  const checkResult = document.getElementById('check-result');
  const checkHint = document.getElementById('check-hint');

  function currentMode() {
    for (const el of modeInputs) if (el.checked) return el.value;
    return '';
  }

  function syncMode() {
    const mode = currentMode();
    localFields.hidden = (mode !== 'local');
    directFields.hidden = (mode !== 'direct');
    // Results belong to the mode they were produced for.
    checkResult.innerHTML = '';
    checkHint.textContent = '';
  }

  // The records the admin has to create, filled in as they type. Without
  // a delegation target only the wildcard is needed.
  function syncPreview() {
    const domain = baseDomain.value.trim().toLowerCase() || 'deine-domain.de';
    domainPreview.textContent = 'auth.' + domain + ', pylearn.' + domain;
    let records = '*.' + domain + '   A       ' + (serverIP.value.trim() || '<Server-IP>');
    const target = challengeDomain.value.trim().toLowerCase();
    if (target) {
      records += '\n_acme-challenge.' + domain + '   CNAME   ' + target + '.';
    }
    dnsRecords.textContent = records;
  }

  modeInputs.forEach(el => el.addEventListener('change', syncMode));
  [baseDomain, serverIP, challengeDomain].forEach(el => el.addEventListener('input', syncPreview));
  syncMode();
  syncPreview();

  // --- Prerequisite check ---
  const checkBtn = document.getElementById('check-btn');
  const MARKS = { ok: '✓', warn: '!', fail: '✗', skip: '·' };

  checkBtn.addEventListener('click', function() {
    const domain = baseDomain.value.trim().toLowerCase();
    if (!domain) { baseDomain.focus(); return; }

    checkBtn.disabled = true;
    checkHint.textContent = 'Prüfe …';
    checkResult.innerHTML = '';

    // POST, not GET: the token must not end up in a URL or a server log.
    const params = new URLSearchParams({
      setup_code: document.getElementById('setup-code').value,
      mode: currentMode(),
      base_domain: domain,
      dns_token: dnsToken.value.trim(),
      challenge_domain: challengeDomain.value.trim().toLowerCase(),
    });
    fetch('/setup/preflight', { method: 'POST', body: params })
      .then(resp => {
        if (resp.status === 403) throw new Error('setup-code');
        return resp.json();
      })
      .then(data => {
        const list = document.createElement('ul');
        list.className = 'check-list';
        (data.checks || []).forEach(c => {
          const li = document.createElement('li');
          li.className = 'check check--' + c.status;
          const mark = document.createElement('span');
          mark.className = 'check__mark';
          mark.textContent = MARKS[c.status] || '·';
          const body = document.createElement('div');
          const title = document.createElement('div');
          title.className = 'check__title';
          title.textContent = c.title;
          const detail = document.createElement('div');
          detail.className = 'check__detail';
          detail.textContent = c.detail;
          body.appendChild(title);
          body.appendChild(detail);
          li.appendChild(mark);
          li.appendChild(body);
          list.appendChild(li);
        });
        checkResult.appendChild(list);

        // Failing checks do not block the install: DNS records propagate on
        // their own schedule, and an admin who prepares the server first is
        // doing nothing wrong.
        if (data.summary === 'ok') {
          checkHint.textContent = 'Alles bereit.';
        } else if (data.summary === 'fail') {
          checkHint.textContent = 'Noch nicht vollständig — Setup lässt sich trotzdem abschließen.';
        } else {
          checkHint.textContent = 'Mit Einschränkungen bereit.';
        }
      })
      .catch(err => {
        checkHint.textContent = err.message === 'setup-code'
          ? 'Erst den Einrichtungscode oben eintragen.'
          : 'Prüfung fehlgeschlagen.';
      })
      .finally(() => { checkBtn.disabled = false; });
  });

  // --- Password generator ---
  const genBtn = document.getElementById('gen-password-btn');
  const copyBtn = document.getElementById('copy-password-btn');
  const showBtn = document.getElementById('show-password-btn');
  const pwInput = document.getElementById('password-input');
  const pwConfirm = document.getElementById('password-confirm');
  const pwHint = document.getElementById('password-hint');
  let generatedPW = '';

  genBtn.addEventListener('click', function() {
    generatedPW = generatePassword(20);
    pwInput.type = 'password';
    pwConfirm.type = 'password';
    pwInput.value = generatedPW;
    pwConfirm.value = generatedPW;
    copyBtn.style.display = '';
    showBtn.style.display = '';
    showBtn.textContent = 'Anzeigen';
    pwHint.textContent = 'Passwort generiert – bitte kopieren und sicher aufbewahren.';
    pwHint.style.display = '';
  });

  copyBtn.addEventListener('click', function() {
    stackctlCopy(generatedPW).then(function() {
      pwHint.textContent = 'Kopiert!';
      copyBtn.textContent = 'Kopiert ✓';
      setTimeout(function() {
        copyBtn.textContent = 'Kopieren';
      }, 2000);
    });
  });

  showBtn.addEventListener('click', function() {
    const showing = pwInput.type === 'text';
    pwInput.type = showing ? 'password' : 'text';
    pwConfirm.type = showing ? 'password' : 'text';
    showBtn.textContent = showing ? 'Anzeigen' : 'Verbergen';
  });

  function generatePassword(len) {
    const chars = 'abcdefghjkmnpqrstuvwxyzABCDEFGHJKMNPQRSTUVWXYZ23456789!@#$%&*+-=?';
    const arr = new Uint8Array(len);
    crypto.getRandomValues(arr);
    let pw = '';
    for (let i = 0; i < len; i++) pw += chars[arr[i] % chars.length];
    return pw;
  }
})();
</script>

{{template "foot" .}}
{{end}}

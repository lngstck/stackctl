{{define "title"}}Anmelden{{end}}
{{define "page"}}
{{template "head" .}}
{{template "bare-start" .}}

<form method="post" action="/login" class="ls-card sc-login">
  <h1>Anmelden</h1>
  <p>Verwaltung von learningstack auf diesem Server.</p>
  {{if .Error}}<p class="sc-flash" data-tone="bad" role="alert">{{template "icon" "alert"}}<span>{{.Error}}</span></p>{{end}}
  <div class="ls-field">
    <label for="password">Admin-Passwort</label>
    <input id="password" type="password" name="password" autocomplete="current-password" autofocus required>
  </div>
  <button type="submit" data-size="l" data-busy>Anmelden</button>
</form>

{{template "bare-end" .}}
{{template "foot" .}}
{{end}}

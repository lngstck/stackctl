{{define "title"}}Katalog{{end}}
{{define "page"}}
{{template "head" .}}
{{template "shell-start" .PageData}}

<div class="ls-pagehead">
  <span class="ls-tile" data-size="m">{{template "dock-icon" "bag"}}</span>
  <div>
    <h1>Katalog</h1>
    <p>{{if .CatalogMissing}}Noch nicht geladen{{else if eq .Available 0}}Alles installiert{{else if eq .Available 1}}1 App zum Installieren{{else}}{{.Available}} Apps zum Installieren{{end}}</p>
  </div>
  <form method="post" action="/system/catalog/sync" class="ls-actions">
    {{csrfField .CSRFToken}}
    <input type="hidden" name="return" value="/apps">
    <button type="submit" data-variant="ghost" data-busy>{{template "icon" "refresh"}}Katalog aktualisieren</button>
  </form>
</div>

{{template "flash" .Flash}}
{{if .CatalogMissing}}
<p class="sc-flash" data-tone="bad" role="status">{{template "icon" "alert"}}<span>Der Katalog ist noch nicht geladen. Installierte Apps stehen trotzdem hier; für neue Apps oben „Katalog aktualisieren“.</span></p>
{{end}}

{{range .Shelves}}
<section class="ls-shelf">
  <h3>{{.Title}} <span>{{len .Apps}}</span></h3>
  <div class="ls-launcher" data-size="l">
    {{range .Apps}}
    <button type="button" class="ls-app" data-ls-item="{{.Name}} {{.Category}} {{.Description}}" data-ls-open="app-{{.ID}}">
      {{template "tile" .Tile}}
      <span class="ls-app-name">{{.Label}}</span>
      {{if .Installed}}<span class="ls-app-state">installiert</span>{{else if .IsMandatory}}<span class="ls-app-state" data-tone="bad">zuerst installieren</span>{{end}}
    </button>
    {{end}}
  </div>
</section>
{{end}}
<div class="ls-empty" data-ls-empty hidden>{{template "dock-icon" "search"}}<strong>Keine App gefunden.</strong><span>Der Katalog wächst. Was fehlt dir?</span></div>

{{range .Apps}}
<dialog class="ls-sheet" id="app-{{.ID}}" aria-labelledby="app-{{.ID}}-title">
  <form method="dialog" class="ls-sheet-bar"><button class="ls-iconbtn" aria-label="Schließen">{{template "icon" "x"}}</button></form>
  <div class="ls-sheet-hero">
    {{template "tile" (tileSize .Tile "")}}
    <h2 id="app-{{.ID}}-title">{{.Name}}</h2>
    {{if .Description}}<p>{{.Description}}</p>{{end}}
    {{if .Installed}}
    <span class="ls-pill" data-tone="ok">installiert</span>
    <div class="ls-actions"><a class="ls-btn" href="/apps/{{.ID}}">Auf Start ansehen</a></div>
    {{else if .Version}}
    <span class="ls-pill" data-dot="no">Version {{.Version}}</span>
    {{end}}
  </div>

  {{if not .Installed}}
  {{if .IsMandatory}}<p class="sc-sheet-note" data-tone="warn">{{template "icon" "info"}}<span>Pflicht-Dienst — zuerst installieren. Andere Apps bauen darauf auf.</span></p>{{end}}
  {{if .Error}}<p class="sc-flash" data-tone="bad" role="alert">{{template "icon" "alert"}}<span>{{.Error}}</span></p>{{end}}

  {{if .Missing}}
  <p class="sc-sheet-note" data-tone="warn">{{template "icon" "alert"}}<span>Braucht zuerst: {{join .Missing ", "}}.</span></p>
  {{else if not .Version}}
  <p class="sc-sheet-note" data-tone="bad">{{template "icon" "alert"}}<span>Die Beschreibung dieser App fehlt. Bitte oben „Katalog aktualisieren“.</span></p>
  {{else}}
  <form method="post" action="/apps/{{.ID}}/install">
    {{csrfField $.CSRFToken}}
    {{if .Prompts}}
    <span class="ls-list-label">Einstellungen</span>
    <div class="ls-list">
      {{$app := .}}
      {{range .Prompts}}
      <div class="ls-field">
        <label for="{{$app.ID}}-{{.Key}}">{{.Question}}</label>
        {{$val := index $app.Values .Key}}
        {{if .Options}}
        <select id="{{$app.ID}}-{{.Key}}" name="{{.Key}}">
          {{range .Options}}<option value="{{.}}"{{if eq . $val}} selected{{end}}>{{.}}</option>{{end}}
        </select>
        {{else}}
        <input id="{{$app.ID}}-{{.Key}}" type="text" name="{{.Key}}" value="{{$val}}" placeholder="{{.Default}}"{{if .Required}} required{{end}}>
        {{end}}
        {{if .Hint}}<span class="ls-field-hint">{{.Hint}}</span>{{end}}
      </div>
      {{end}}
    </div>
    {{end}}

    {{if or .HasOIDC .Secrets .UsesAdminPw}}
    <span class="ls-list-label">Gut zu wissen</span>
    <div class="ls-list">
      {{if .HasOIDC}}<div class="ls-row"><span class="ls-row-label">Anmeldung mit Schulkonto<small>{{if .AutoAddress}}Die App bekommt gleich ihre Adresse im Schulnetz.{{else}}Funktioniert erst, wenn die App eine Adresse hat. Im direkten Betrieb ist sie damit aus dem Internet erreichbar.{{end}}</small></span>{{template "icon" "key"}}</div>{{end}}
      {{if or .Secrets .UsesAdminPw}}<div class="ls-row"><span class="ls-row-label">Zugangsdaten erzeugt stackctl selbst<small>{{if .UsesAdminPw}}Die App benutzt das Admin-Passwort von stackctl.{{else}}Was du davon brauchst, steht nach der Installation da.{{end}}</small></span>{{template "icon" "lock"}}</div>{{end}}
    </div>
    {{end}}

    <div class="ls-sheet-foot">
      <button type="submit" data-size="l" data-busy>{{template "icon" "download"}}Installieren</button>
    </div>
  </form>
  {{end}}
  {{end}}
</dialog>
{{end}}

{{template "shell-end" .PageData}}
{{template "foot" .}}
{{end}}

{{define "title"}}Zugang{{end}}
{{define "page"}}
{{template "head" .}}
{{template "shell-start" .PageData}}

<div class="ls-pagehead">
  <span class="ls-tile" data-size="m">{{template "dock-icon" "shield"}}</span>
  <div>
    <h1>Zugang</h1>
    <p>{{if eq .Mode "local"}}<span class="ls-where" data-where="school">{{template "dock-icon" "school"}}Schulnetz</span>{{else}}<span class="ls-where" data-where="internet">{{template "dock-icon" "globe"}}Internet</span>{{end}} {{.ModeLabel}}{{if .BaseDomain}} · <code>*.{{.BaseDomain}}</code>{{end}}</p>
  </div>
  <div class="ls-actions"><button type="button" data-variant="ghost" id="health-btn">{{template "icon" "refresh"}}Erneut prüfen</button></div>
</div>

{{if .Notice}}<p class="sc-flash" data-tone="bad" role="alert">{{template "icon" "alert"}}<span>{{.Notice}}</span></p>{{end}}

<div class="sc-columns">
  <div>
    <span class="ls-list-label">Prüfung</span>
    <div class="ls-list" id="health-result" aria-live="polite">
      <div class="ls-row"><span class="ls-row-label">Wird geprüft …</span></div>
    </div>
    <p class="ls-list-hint">
      {{if eq .Mode "local"}}Login und Apps sind nur im Schulnetz erreichbar. Der Eintrag <code>*.{{.BaseDomain}}</code> zeigt auf diesen Server, das Zertifikat kommt über deSEC.
      {{else}}Dieser Server nimmt den Verkehr selbst an und holt seine Zertifikate bei Let's Encrypt. Dafür muss <code>*.{{.BaseDomain}}</code> hierher zeigen und Port 80 und 443 aus dem Internet erreichbar sein.{{end}}
    </p>
  </div>

  <div>
    <span class="ls-list-label">Anmeldung und Verwaltung</span>
    <div class="ls-list">
      <div class="ls-row">
        <span class="ls-tile" data-size="s" style="--ls-hue: 260">{{template "dock-icon" "key"}}</span>
        <span class="ls-row-label">Anmeldung<small><code>{{.AuthHost}}</code></small></span>
        {{template "route-pill" .AuthStatus}}
        {{if eq .AuthStatus "running"}}
        <button type="button" data-size="s" data-variant="ghost" data-ls-open="auth-stop">Stoppen</button>
        {{else}}
        <form method="post" action="/public/auth/start">{{csrfField .CSRFToken}}<button type="submit" data-size="s" data-busy>{{if eq .AuthStatus "error"}}Neu einrichten{{else}}Starten{{end}}</button></form>
        {{end}}
      </div>
      <div class="ls-row">
        <span class="ls-tile" data-size="s">{{template "dock-icon" "gear"}}</span>
        <span class="ls-row-label">Diese Verwaltung<small><code>{{.AdminHost}}</code> · im Schulnetz immer unter <code>{{.AdminLocalAddr}}</code></small></span>
        {{if eq .AdminStatus "stopped"}}<span class="ls-pill" data-tone="off">aus</span>{{else}}{{template "route-pill" .AdminStatus}}{{end}}
        {{if eq .AdminStatus "stopped"}}
        <button type="button" data-size="s" data-variant="ghost" data-ls-open="admin-start">Einschalten</button>
        {{else}}
        <form method="post" action="/public/admin/stop">{{csrfField .CSRFToken}}<button type="submit" data-size="s" data-variant="ghost" data-busy>Ausschalten</button></form>
        {{end}}
      </div>
    </div>
    <p class="ls-list-hint">Die Anmeldung braucht jede App mit Schulkonto, sie läuft immer. Die Verwaltung unter eigener Adresse ist aus, bis du sie einschaltest.</p>
    {{if eq .Mode "local"}}<p class="ls-list-hint">Zugang von außen richtet stackctl nicht ein. Wer ihn über VPN oder einen eigenen Tunnel löst, muss <code>{{.AuthHost}}</code> mit nach außen geben, sonst scheitert der Login.</p>{{end}}

    <span class="ls-list-label">Apps</span>
    <div class="ls-list">
      {{range .Apps}}
      <div class="ls-row">
        {{template "tile" .Tile}}
        <span class="ls-row-label">{{.Name}}<small>{{if .Published}}<a href="https://{{.PublicHost}}" target="_blank" rel="noopener">{{.PublicHost}}</a>{{else}}keine Adresse{{if .HasOIDC}}, Anmeldung geht so nicht{{end}}{{end}}</small></span>
        {{if .Published}}{{template "route-pill" .PublishState}}{{else}}<span class="ls-pill" data-tone="{{if .HasOIDC}}warn{{else}}off{{end}}">aus</span>{{end}}
        {{if .Published}}
        <form method="post" action="/apps/{{.ID}}/public/disable">{{csrfField $.CSRFToken}}<button type="submit" data-size="s" data-variant="ghost" data-busy>Abschalten</button></form>
        {{else}}
        <form method="post" action="/apps/{{.ID}}/public/enable">{{csrfField $.CSRFToken}}<button type="submit" data-size="s" data-busy>Einschalten</button></form>
        {{end}}
      </div>
      {{else}}
      <div class="ls-row"><span class="ls-row-label">Noch keine Apps<small>Die Grundversorgung steht hier nicht.</small></span></div>
      {{end}}
    </div>
  </div>
</div>

<dialog class="ls-dialog" id="auth-stop" aria-labelledby="auth-stop-t">
  <form method="post" action="/public/auth/stop">
    {{csrfField .CSRFToken}}
    <h2 id="auth-stop-t">Anmeldung stoppen?</h2>
    <p>Dann meldet sich niemand mehr in einer App an, bis du sie wieder startest. Nur zur Fehlersuche.</p>
    <div class="ls-actions"><button type="button" data-variant="ghost" data-close>Abbrechen</button><button type="submit" data-variant="danger" data-busy>Stoppen</button></div>
  </form>
</dialog>

<dialog class="ls-dialog" id="admin-start" aria-labelledby="admin-start-t">
  <form method="post" action="/public/admin/start">
    {{csrfField .CSRFToken}}
    <h2 id="admin-start-t">Verwaltung unter {{.AdminHost}}?</h2>
    <p>Sie ist dann zusätzlich unter dieser Adresse erreichbar{{if ne .Mode "local"}}, auch aus dem Internet{{end}}. Von dort lassen sich Apps installieren, Zugangsdaten ansehen und Sicherungen zurückspielen, geschützt nur durch das Admin-Passwort.</p>
    <p>Unter {{.AdminLocalAddr}} bleibt sie wie bisher erreichbar.</p>
    <div class="ls-actions"><button type="button" data-variant="ghost" data-close>Abbrechen</button><button type="submit" data-busy>Einschalten</button></div>
  </form>
</dialog>

{{template "shell-end" .PageData}}
<script>
(function () {
  var btn = document.getElementById('health-btn');
  var out = document.getElementById('health-result');
  var TONE = { ok: 'ok', warn: 'warn', fail: 'bad', skip: 'off' };
  var WORD = { ok: 'in Ordnung', warn: 'Hinweis', fail: 'Fehler', skip: 'übersprungen' };

  function row(label, detail, status) {
    var r = document.createElement('div');
    r.className = 'ls-row';
    var l = document.createElement('span');
    l.className = 'ls-row-label';
    l.textContent = label;
    if (detail) { var d = document.createElement('small'); d.textContent = detail; l.appendChild(d); }
    r.appendChild(l);
    if (status) {
      var p = document.createElement('span');
      p.className = 'ls-pill'; p.dataset.tone = TONE[status] || 'off'; p.textContent = WORD[status] || status;
      r.appendChild(p);
    }
    return r;
  }

  function load() {
    btn.setAttribute('aria-busy', 'true'); btn.disabled = true;
    fetch('/public/health', { cache: 'no-store' })
      .then(function (resp) { return resp.json(); })
      .then(function (data) {
        out.replaceChildren.apply(out, (data.checks || []).map(function (c) { return row(c.title, c.detail, c.status); }));
      })
      .catch(function () { out.replaceChildren(row('Prüfung fehlgeschlagen', 'stackctl hat nicht geantwortet.', 'fail')); })
      .finally(function () { btn.removeAttribute('aria-busy'); btn.disabled = false; });
  }

  btn.addEventListener('click', load);
  load();
})();
</script>
{{template "foot" .}}
{{end}}

{{define "route-pill"}}{{if eq . "running"}}<span class="ls-pill" data-tone="ok">aktiv</span>{{else if eq . "error"}}<span class="ls-pill" data-tone="bad">Fehler</span>{{else}}<span class="ls-pill" data-tone="warn">gestoppt</span>{{end}}{{end}}
